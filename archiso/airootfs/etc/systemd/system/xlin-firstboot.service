[Unit]
Description=XlinOS first-boot setup (create the first user)
ConditionPathExists=!/var/lib/xlin/setup-done
After=systemd-user-sessions.service
Before=getty@tty1.service getty.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/xlin-firstboot
StandardInput=tty
StandardOutput=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
