{
  "hostname": "xlin",
  "kernels": ["linux"],
  "ntp": true,
  "services": ["NetworkManager", "bluetooth", "power-profiles-daemon", "fstrim.timer"],
  "packages": [
    "hyprland", "hyprlock", "gtk-session-lock", "jq", "socat", "libnotify", "brightnessctl", "networkmanager",
    "pipewire", "pipewire-alsa", "pipewire-pulse", "wireplumber", "bluez", "bluez-utils", "inter-font", "noto-fonts", "ttf-nerd-fonts-symbols",
    "ttf-jetbrains-mono-nerd", "gtk3", "gtk4", "python-gobject", "gtk4-layer-shell", "power-profiles-daemon",
    "hyprlock", "hypridle", "vte4", "polkit", "hyprpolkitagent", "udisks2", "gvfs",
    "gvfs-smb", "grim", "wl-clipboard", "playerctl", "xdg-desktop-portal-hyprland",
    "xdg-desktop-portal-gtk", "gst-plugins-base", "gst-plugins-good", "gst-plugins-bad", "gst-libav",
    "gst-plugin-gtk4", "gtksourceview5", "poppler-glib", "kitty", "zram-generator", "sudo", "git", "greetd", "cage",
    "plymouth", "mesa", "vulkan-icd-loader", "sof-firmware", "nano"
  ],
  "custom_commands": [
    "echo @POST_B64@ | base64 -d | bash"
  ]
}
