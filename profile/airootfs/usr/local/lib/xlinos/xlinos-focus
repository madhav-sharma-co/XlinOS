#!/usr/bin/env python3
"""xlinos-focus CLASS COMMAND: bring the app's window to the front (restoring it if minimised), else start it."""
import json, subprocess, sys

def xc(*a):
    return subprocess.run(["xlinctl", *a], capture_output=True, text=True, timeout=4).stdout

cls, cmd = (sys.argv[1] if len(sys.argv) > 1 else ""), sys.argv[2:]
if not cls:
    sys.exit(0)
wins = [c for c in json.loads(xc("clients") or "[]") if (c.get("class") or "").lower() == cls.lower()]
if not wins:
    subprocess.Popen(cmd, start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    sys.exit(0)
xc("focus", wins[0]["address"])
