    def rescan(self):
        def done(r):
            if isinstance(r, Exception): return
            self.scan_failed = r is None; self.c.disks = r or []
            if self.c.disk and not core.disk_by_path(self.c, self.c.disk): self.c.disk = ""; self.c.method = ""; self.c.efi = ""
            self.render_disks(); self.render_methods(); self.update_next()
        bg(core.scan_disks, done)

    def pick_disk(self, d):
        if self.c.disk != d["path"] and not any(p["path"] == self.c.disk for p in d["partitions"]):
            self.c.disk = ""; self.c.method = ""; self.c.efi = ""; self.c.confirmed_loss = False
        self.sel_disk = d; self.render_disks(); self.render_methods(); self.update_next()

    # -- C. method
    def render_methods(self):
        while (ch := self.method_card.get_first_child()): self.method_card.remove(ch)
        self.method_card.append(lbl(self.L("sec_method"), "h2"))
        d = self.sel_disk
        if d is None and self.c.disk: d = core.disk_by_path(self.c, self.c.disk)
        if d is None:
