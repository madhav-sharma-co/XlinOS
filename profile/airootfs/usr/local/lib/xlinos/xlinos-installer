    Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), p, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 5)
    Installer(app).present()


app = Gtk.Application(application_id="os.xlin.installer", flags=Gio.ApplicationFlags.NON_UNIQUE)
