    def confirm_install(self):
        dlg = Gtk.Window(transient_for=self, modal=True, decorated=False, resizable=False); dlg.add_css_class("xl")
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14, margin_top=26, margin_bottom=26, margin_start=30, margin_end=30)
        box.append(lbl("Start the installation?", "h2")); box.append(lbl(core.losses(self.c) + " The installation cannot be undone once it starts.", width_chars=48, max_width_chars=60))
        bt = Gtk.Box(spacing=10, halign=Gtk.Align.END)
        c = Gtk.Button(label=self.L("cancel")); c.connect("clicked", lambda _b: dlg.close())
        go = Gtk.Button(label=self.L("install")); go.add_css_class("danger"); go.connect("clicked", lambda _b: (dlg.close(), self.start_install()))
        bt.append(c); bt.append(go); box.append(bt); dlg.set_child(box); dlg.present()

    # ---------------------------------------------------------------- screen 6
    def build_install(self):
        self.i_title = lbl(self.L("thanks"), "h1", xalign=0.5); self.i_msg = lbl(self.L("thanks_msg"), "sub", xalign=0.5, justify=Gtk.Justification.CENTER)
        self.i_pct = lbl("0%", "pct", xalign=0.5); self.i_bar = Gtk.ProgressBar()
        self.i_stage = lbl("", "h2", xalign=0.5); self.i_task = lbl("", "small", xalign=0.5)
        self.log_tv = Gtk.TextView(editable=False, cursor_visible=False, wrap_mode=Gtk.WrapMode.CHAR, monospace=True); self.log_tv.add_css_class("logbox")
        lsw = Gtk.ScrolledWindow(min_content_height=200, max_content_height=260); lsw.set_child(self.log_tv)
        self.i_exp = Gtk.Expander(label=self.L("show_log")); self.i_exp.set_child(lsw)
        self.i_cancel = Gtk.Button(label=self.L("cancel"), halign=Gtk.Align.CENTER); self.i_cancel.connect("clicked", lambda _b: self.ask_cancel())
        self.i_action = Gtk.Button(halign=Gtk.Align.CENTER); self.i_action.add_css_class("primary"); self.i_action.set_visible(False)
        self.i_note = lbl("", "sub", xalign=0.5, justify=Gtk.Justification.CENTER)
        self.i_logo = mark(90)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14, halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER, width_request=min(self.width, 820))
        for w in (self.i_logo, self.i_title, self.i_msg, self.i_pct, self.i_bar, self.i_stage, self.i_task, self.i_exp, self.i_note, self.i_cancel, self.i_action): box.append(w)
        return box

    def start_install(self):
        c = self.c
        errs = core.check_step(4, c)
        if errs: self.show("disk"); self.err.set_text(errs[0]); return
        opts = "/tmp/xlinos-install-options.json"
        json.dump(core.engine_options(c), open(opts, "w"))
        cmd = [ENGINE, c.disk, opts]
        if os.geteuid() != 0: cmd = ["sudo", "-n"] + cmd
        self.running = True; self.cancelling = False; self.modified = False
        self.show("install"); self.head.set_visible(False)
        self.i_title.set_text(self.L("thanks")); self.i_msg.set_text(self.L("thanks_msg")); self.i_cancel.set_visible(True); self.i_action.set_visible(False)
        self.i_note.set_text(""); self.i_bar.set_fraction(0); self.i_pct.set_text("0%"); self.i_stage.set_text("Preparing installation"); self.i_task.set_text("")
        GLib.timeout_add(1500, self.tail_log)
        threading.Thread(target=self.worker, args=(cmd,), daemon=True).start()

    def worker(self, cmd):
        try: p = subprocess.Popen(cmd, stdout=subprocess.PIPE, text=True)
        except Exception as e: GLib.idle_add(self.finish, "fail", "Could not start the installer: %s" % e); return
        self.proc = p; result = ("fail", "The installation stopped unexpectedly.")
        for line in p.stdout:
            line = line.strip()
            if line.startswith("STEP "): GLib.idle_add(self.on_step, line[5:])
            elif line.startswith("PCT "):
                try: GLib.idle_add(self.on_pct, int(line[4:]))
                except ValueError: pass
            elif line == "MODIFIED": self.modified = True
            elif line.startswith("FAIL"): result = ("fail", line[5:] or "The installation failed.")
            elif line.startswith("CANCELLED"): result = ("cancelled", line.split(" ")[-1])
            elif line == "DONE": result = ("done", "")
        p.wait(); GLib.idle_add(self.finish, *result)

    def on_step(self, text): self.i_stage.set_text(text); return False

    def on_pct(self, n):
        self.i_bar.set_fraction(n / 100.0); self.i_pct.set_text("%d%%" % n); return False

    def tail_log(self):
        if not self.running: return False
        try:
            data = open(LOGFILE, "rb").read()[-6000:].decode("utf-8", "replace").replace("\r", "\n")
            lines = [l for l in data.splitlines() if l.strip() and not l.startswith("+")][-30:]
            self.log_tv.get_buffer().set_text("\n".join(lines))
            if lines: self.i_task.set_text(lines[-1][:110])
        except Exception: pass
        return True

    def ask_cancel(self):
        dlg = Gtk.Window(transient_for=self, modal=True, decorated=False, resizable=False); dlg.add_css_class("xl")
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14, margin_top=26, margin_bottom=26, margin_start=30, margin_end=30)
        box.append(lbl("Cancel the installation?", "h2"))
        box.append(lbl("Steps that change the disk layout or the start-up files are finished first, so nothing is left half written. An unfinished installation does not start.", width_chars=48, max_width_chars=60))
        bt = Gtk.Box(spacing=10, halign=Gtk.Align.END)
        keep = Gtk.Button(label="Keep installing"); keep.connect("clicked", lambda _b: dlg.close())
        stop = Gtk.Button(label="Cancel installation"); stop.add_css_class("danger")
        stop.connect("clicked", lambda _b: (dlg.close(), self.do_cancel()))
        bt.append(keep); bt.append(stop); box.append(bt); dlg.set_child(box); dlg.present()

    def do_cancel(self):
        def done(r):
            out = (r.stdout or "").strip() if not isinstance(r, Exception) else "idle"
            if out == "queued": self.i_note.set_text("A step that must not be interrupted is running. The installation stops as soon as it is safe.")
            elif out == "stopping": self.i_note.set_text("Stopping…")
            self.i_cancel.set_sensitive(False)
        cmd = ["sudo", "-n", CANCEL] if os.geteuid() != 0 else [CANCEL]
        bg(lambda: subprocess.run(cmd, capture_output=True, text=True, timeout=20), done)

    def finish(self, kind, info):
        self.running = False; self.i_cancel.set_visible(False); self.i_exp.set_expanded(False)
        back = lambda: (self.i_action.set_visible(False), self.show("disk"))
        def act(label, fn):
            self.i_action.set_label(label); self.i_action.set_visible(True)
            if self._act: self.i_action.disconnect(self._act)
            self._act = self.i_action.connect("clicked", lambda _b: fn())
        if kind == "done":
            self.i_logo.set_visible(True); self.i_title.set_text(self.L("ready")); self.i_msg.set_text(self.L("ready_msg"))
            self.i_bar.set_fraction(1); self.i_pct.set_text("100%"); self.i_stage.set_text("Finalizing installation")
            mk = core.media_kind(self.c)
            self.i_note.set_text({"usb": "Remove the USB drive when the computer restarts, so it starts XlinOS from the disk. You will create your user on the first start.",
                                  "file": "XlinOS was started from a file on another disk. Restart and choose XlinOS in the start menu. You will create your user on the first start.",
                                  "other": "Remove the installation disc or media if there is one, then restart. You will create your user on the first start."}[mk])
            act(self.L("restart"), lambda: subprocess.Popen(["sudo", "-n", "systemctl", "reboot"] if os.geteuid() else ["systemctl", "reboot"]))
        elif kind == "cancelled":
            self.i_title.set_text("Installation cancelled"); self.i_stage.set_text(""); self.i_msg.set_text("")
            self.i_note.set_text("The installation was stopped before anything on your disk was changed. Nothing was lost." if info == "clean" else
                                 "The installation was stopped after the disk had already been changed. XlinOS is NOT installed on it and the part that was written is unusable. Run the installer again to install XlinOS, or restart and use your other system if the disk was not erased completely.")
            act("Back to setup", back)
        else:
            self.i_title.set_text("The installation did not finish"); self.i_stage.set_text(""); self.i_msg.set_text(info)
            self.i_note.set_text("The full log is in " + LOGFILE + ". Open the details below to see the last lines. " + ("The disk had already been changed, so the system on it is incomplete and will not start." if self.modified else "Nothing on your disk was changed."))
            self.i_exp.set_expanded(True); self.tail_once()
            act("Back to setup", back)
        return False

    def tail_once(self):
        try:
            data = open(LOGFILE, "rb").read()[-6000:].decode("utf-8", "replace").replace("\r", "\n")
            self.log_tv.get_buffer().set_text("\n".join([l for l in data.splitlines() if l.strip() and not l.startswith("+")][-30:]))
        except Exception: pass

    # ---------------------------------------------------------------- test hook (off unless XLINOS_INSTALLER_TEST is set to a folder)
    def setup_test_hook(self):
        self.testdir = os.environ.get("XLINOS_INSTALLER_TEST")
        if not self.testdir: return
        os.makedirs(self.testdir, exist_ok=True)
        GLib.timeout_add(400, self.poll)

    def poll(self):
        f = os.path.join(self.testdir, "cmd")
        try:
            lines = open(f).read().splitlines(); os.remove(f)
        except Exception: return True
        for l in lines:
            try: self.test_cmd(l.split())
            except Exception as e: open(os.path.join(self.testdir, "errors.txt"), "a").write("%s: %r\n" % (l, e))
        return True

    def test_cmd(self, a):
        c = self.c
        if a[0] == "next": self.step(1)
        elif a[0] == "back": self.step(-1)
        elif a[0] == "goto": self.goto(int(a[1]))
        elif a[0] == "lang": c.locale = a[1]; self.apply_locale_defaults(); self.build_all()
        elif a[0] == "agree": c.agreed = True; self.acc.set_active(True)
        elif a[0] == "kb": c.kb = a[1]; c.kb_variant = a[2] if len(a) > 2 else ""; self.apply_kb(); self.build_all()
        elif a[0] == "disk": d = next(x for x in c.disks if x["path"] == a[1]); self.pick_disk(d)
        elif a[0] == "method": self.pick_method(self.sel_disk, a[1])
        elif a[0] == "loss": c.confirmed_loss = True
        elif a[0] == "state": open(os.path.join(self.testdir, "state.json"), "w").write(json.dumps({"page": self.page, "err": self.err.get_text(), "locale": c.locale, "country": c.country, "tz": c.tz, "kb": c.kb, "agreed": c.agreed, "method": c.method, "disk": c.disk, "efi": c.efi, "next_sensitive": self.next_b.get_sensitive(), "title": self.i_title.get_text(), "pct": self.i_pct.get_text(), "stage": self.i_stage.get_text(), "note": self.i_note.get_text(), "running": self.running, "test_text": self.test_entry.get_text() if self.test_entry else ""}))
        elif a[0] == "type": self.test_entry.set_text(a[1])
        elif a[0] == "start": self.start_install()
        elif a[0] == "cancel": self.do_cancel()
        elif a[0] == "shot": self.shot(a[1])

    def shot(self, path):
        p = Gtk.WidgetPaintable.new(self); w, h = self.get_width(), self.get_height()
        snap = Gtk.Snapshot(); p.snapshot(snap, w, h)
        node = snap.to_node(); tex = self.get_native().get_renderer().render_texture(node, None); tex.save_to_png(path)


