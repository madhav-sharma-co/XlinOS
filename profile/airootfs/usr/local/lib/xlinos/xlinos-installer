        card2 = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14); card2.add_css_class("card")
        for r in (row(self.L("kb_layout"), kbd), row(self.L("kb_variant"), var_box), row(self.L("kb_test"), test)): card2.append(r)
        card2.append(self.kb_note)
