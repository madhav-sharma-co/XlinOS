            if self.c.method == "erase":
                row = Gtk.Box(spacing=14); row.append(lbl("File system", "key", wrap=False))
                row.append(dropdown(["ext4 - simple and fast", "btrfs - snapshots and compression"], 0 if self.c.fs == "ext4" else 1, lambda i: setattr(self.c, "fs", "ext4" if i == 0 else "btrfs"), searchable=False))
                self.method_card.append(row)
            if self.c.method in ("partition", "freespace"):
