                    row.append(dropdown(names, names.index(self.c.efi) if self.c.efi in names else 0, lambda i: setattr(self.c, "efi", names[i]), searchable=False))
                    self.method_card.append(row)
                else:
                    self.method_card.append(lbl("Shared start-up (EFI) partition: %s" % self.c.efi, "small"))
            if self.c.method == "freespace":
                self.method_card.append(lbl("A new partition of about %s is created in the largest free space." % core.human(d.get("biggest_gap", 0)), "small"))

    def pick_method(self, d, m):
        self.c.method = m; self.c.confirmed_loss = False
        self.c.efi = ""
        esps = [p["path"] for p in d["partitions"] if p["esp"]]
        if m == "partition":
            free = core.free_partitions(d)
            self.c.disk = free[0]["path"] if free else ""
            self.part_dialog(d, free)
        else:
            self.c.disk = d["path"]
        if m in ("partition", "freespace") and esps: self.c.efi = esps[0]
        self.sel_disk = d; self.render_disks(); self.render_methods(); self.update_next()

