        allowed = core.methods_for(d)
        info = {
            "freespace": ("Install alongside an existing operating system",
                          "XlinOS is installed into free (unallocated) space on this disk. Windows, Linux and your files are not changed, and XlinOS shows up in the start menu next to them. Shrink a partition of your other system first if there is no free space. macOS is not supported."),
            "erase": ("Erase disk and install XlinOS",
                      "Everything on this disk is erased and XlinOS uses the whole disk. Other systems on it are removed."),
            "partition": ("Manual: use a partition you choose (advanced)",
                          "You pick one existing partition for XlinOS (it is erased) and the start-up (EFI) partition to share. Nothing else on the disk is changed. Create the partitions first with a partition editor."),
        }
