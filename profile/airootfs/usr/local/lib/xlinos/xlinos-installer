STEPS = ["welcome", "about", "region", "disk", "review"]


def lbl(text, cls=None, wrap=True, xalign=0.0, **k):
    l = Gtk.Label(label=text, wrap=wrap, xalign=xalign, **k)
    if wrap and 'max_width_chars' not in k: l.set_max_width_chars(100)
    if cls:
        for c in cls.split(): l.add_css_class(c)
    return l


def mark(size):
    p = os.path.join(SHARE, "xlinos-mark.png")
    if not os.path.exists(p): return Gtk.Box()
    img = Gtk.Image.new_from_file(p); img.set_pixel_size(size); return img


def dropdown(items, selected=0, on_change=None, searchable=True):
    dd = Gtk.DropDown.new(Gtk.StringList.new(list(items)), None)
    if searchable and len(items) > 12:
        dd.set_expression(Gtk.PropertyExpression.new(Gtk.StringObject, None, "string")); dd.set_enable_search(True)
    dd.set_selected(max(0, min(selected, max(0, len(items) - 1))))
    if on_change: dd.connect("notify::selected", lambda d, _p: on_change(d.get_selected()))
    return dd


def bg(fn, done):
    def run():
        try: r = fn()
        except Exception as e: r = e
        GLib.idle_add(done, r)
    threading.Thread(target=run, daemon=True).start()


class Installer(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app)
        self.add_css_class("xl"); self.set_decorated(False); self.fullscreen()
        self.c = core.Choices()
        self.page = "loading"; self.running = False; self.proc = None; self.final = False
        self.lay, self.var = {}, {}
        self.sel_disk = None; self.scan_failed = False; self.wifi = []; self.test_entry = None; self.cancelling = False; self._act = None
        self.width = 960
        try:
            mon = Gdk.Display.get_default().get_monitors().get_item(0).get_geometry()
            self.width = max(560, min(1040, mon.width - 120))
        except Exception: pass
        self.root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL); self.set_child(self.root)
        self.head = Gtk.Box(spacing=14, margin_top=18, margin_start=32, margin_end=32)
        self.head.append(mark(30)); self.head.append(lbl("XlinOS", "h2", wrap=False))
        sp = Gtk.Box(hexpand=True); self.head.append(sp)
        self.dots = Gtk.Box(spacing=8, valign=Gtk.Align.CENTER); self.head.append(self.dots)
        self.root.append(self.head)
        self.stack = Gtk.Stack(vexpand=True, transition_type=Gtk.StackTransitionType.CROSSFADE, transition_duration=220)
        self.root.append(self.stack)
        self.foot = Gtk.Box(spacing=12, margin_bottom=22, margin_start=32, margin_end=32, margin_top=8)
        self.err = lbl("", "err", hexpand=True); self.back_b = Gtk.Button(); self.next_b = Gtk.Button(); self.next_b.add_css_class("primary")
        self.back_b.connect("clicked", lambda _b: self.step(-1)); self.next_b.connect("clicked", lambda _b: self.step(1))
        self.foot.append(self.back_b); self.foot.append(self.err); self.foot.append(self.next_b)
        self.root.append(self.foot)
        self.connect("close-request", lambda w: bool(self.running))
        self.build_all()
        self.show("loading")
        bg(self.load, self.loaded)
        self.setup_test_hook()

    # ---------------------------------------------------------------- plumbing
    def L(self, key): return tr(self.c.locale, key)

    def page_box(self, *widgets, center=False):
        outer = Gtk.ScrolledWindow(vexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER)
        col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16, halign=Gtk.Align.CENTER, width_request=self.width,
                      valign=Gtk.Align.CENTER if center else Gtk.Align.START, margin_top=10, margin_bottom=10)
        for w in widgets: col.append(w)
        outer.set_child(col); return outer

    def build_all(self):
        """(Re)builds every screen, so a language change is shown everywhere at once."""
        cur = self.page
        for n in ("welcome", "about", "region", "disk", "review"):
            old = self.stack.get_child_by_name(n)
            if old: self.stack.remove(old)
        self.stack.add_named(self.build_welcome(), "welcome"); self.stack.add_named(self.build_about(), "about")
        self.stack.add_named(self.build_region(), "region"); self.stack.add_named(self.build_disk(), "disk")
        self.stack.add_named(self.build_review(), "review")
        if self.stack.get_child_by_name("loading") is None:
            self.stack.add_named(self.build_loading(), "loading"); self.stack.add_named(self.build_install(), "install")
        self.show(cur, rebuilt=True)

    def show(self, name, rebuilt=False):
        self.page = name
        self.stack.set_visible_child_name(name)
        self.err.set_text("")
        idx = STEPS.index(name) if name in STEPS else -1
        while (ch := self.dots.get_first_child()): self.dots.remove(ch)
        if idx >= 0:
            for i in range(len(STEPS)):
                d = Gtk.Box(); d.add_css_class("dot")
                if i == idx: d.add_css_class("on")
                elif i < idx: d.add_css_class("done")
                self.dots.append(d)
        self.head.set_visible(name != "loading")
        self.foot.set_visible(idx >= 0)
        self.back_b.set_visible(idx > 0)
        self.back_b.set_label(self.L("back"))
        self.next_b.set_label(self.L("install") if name == "review" else self.L("continue"))
        if name == "review": self.next_b.add_css_class("danger") if core.destructive(self.c) else None
        else: self.next_b.remove_css_class("danger")
        if name == "disk": self.refresh_net(); self.update_next()
        if name == "about": self.update_next()

    def step(self, d):
        idx = STEPS.index(self.page)
        if d > 0:
            e = core.check_step(idx + 1, self.c)
            if e: self.err.set_text(e[0]); return
            if self.page == "review": self.confirm_install(); return
            self.show(STEPS[idx + 1]);
            if STEPS[idx + 1] == "review": self.build_all()
        elif idx > 0: self.show(STEPS[idx - 1])

    def goto(self, n):
        self.show(STEPS[n - 1])

    def update_next(self):
        idx = STEPS.index(self.page) if self.page in STEPS else 0
        self.next_b.set_sensitive(not core.check_step(idx + 1, self.c) or self.page not in ("about", "disk"))

    # ---------------------------------------------------------------- screen 0
    def build_loading(self):
        sp = Gtk.Spinner(); sp.start()
        b = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=26, halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER)
        b.append(mark(140)); b.append(sp); b.append(lbl(tr(self.c.locale, "loading"), "sub", xalign=0.5))
        return b

    def load(self):
        t0 = time.time()
        lay, var = core.keyboards(); disks = core.scan_disks(); net = core.net_status()
        return lay, var, disks, net, t0

    def loaded(self, r):
        if isinstance(r, Exception): r = ({}, {}, [], {"state": "unavailable", "text": "unknown"}, time.time())
        self.lay, self.var, disks, self.c.net, _ = r
        self.scan_failed = disks is None; self.c.disks = disks or []
        self.c.net_info = self.c.net
        self.c.kb = core.default_keyboard(self.c.locale, self.lay)
        self.apply_locale_defaults()
        self.build_all(); self.show("welcome")

