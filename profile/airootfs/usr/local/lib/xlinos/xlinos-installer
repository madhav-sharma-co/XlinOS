    # ---------------------------------------------------------------- screen 3
    def build_region(self):
        c = self.c
        def row(label, widget):
            b = Gtk.Box(spacing=16); l = lbl(label, "key", wrap=False); l.set_size_request(240, -1); b.append(l); b.append(widget); return b
        names = [n for n, _ in core.LANGS]
        langs = dropdown(names, next((i for i, (_, v) in enumerate(core.LANGS) if v == c.locale), 0), searchable=False)
        def lang_changed(i):
            if core.LANGS[i][1] == c.locale: return
            c.locale = core.LANGS[i][1]; self.apply_locale_defaults(); self.build_all()
        langs.connect("notify::selected", lambda d, _p: lang_changed(d.get_selected()))
        cs = core.countries(); cn = [n for n, _ in cs]
        zone_box = Gtk.Box()
        def fill_zones():
            while (ch := zone_box.get_first_child()): zone_box.remove(ch)
            zs = core.zones_for(c.country)
            if c.tz not in zs and c.tz != "UTC": zs = zs + [c.tz] if c.tz in core.all_zones() else zs
            dd = dropdown(zs, zs.index(c.tz) if c.tz in zs else 0, lambda i: setattr(c, "tz", zs[i]))
            if c.tz not in zs: c.tz = zs[0]
            zone_box.append(dd)
        def country_changed(i):
            c.country = cs[i][1]; c.tz = core.zones_for(c.country)[0]; fill_zones()
        country = dropdown(cn, next((i for i, (_, code) in enumerate(cs) if code == c.country), 0), country_changed)
        fill_zones()
        layouts = sorted(self.lay.items(), key=lambda kv: kv[1]); lnames = ["%s  (%s)" % (n, code) for code, n in layouts]
        var_box = Gtk.Box()
        test = Gtk.Entry(placeholder_text=self.L("kb_test"), width_request=420)
        def fill_variants():
            while (ch := var_box.get_first_child()): var_box.remove(ch)
            vs = [("", self.L("default_variant"))] + list(self.var.get(c.kb, []))
            dd = dropdown([n for _, n in vs], next((i for i, (v, _) in enumerate(vs) if v == c.kb_variant), 0), None, searchable=True)
            def vch(i): c.kb_variant = vs[i][0]; self.apply_kb()
            dd.connect("notify::selected", lambda d, _p: vch(d.get_selected()))
            var_box.append(dd)
        def kb_changed(i):
            c.kb = layouts[i][0]; c.kb_variant = ""; fill_variants(); self.apply_kb()
        kbd = dropdown(lnames, next((i for i, (code, _) in enumerate(layouts) if code == c.kb), 0), kb_changed)
        fill_variants()
        self.kb_note = lbl("", "small")
