    def apply_kb(self):
        ok = core.apply_keyboard(self.c.kb, self.c.kb_variant)
        self.kb_note.set_text("" if ok else "The preview could not switch the keyboard here, but your choice is still used for the new system.")
        if self.test_entry: self.test_entry.set_text(""); self.test_entry.grab_focus()

    # ---------------------------------------------------------------- screen 4
    def build_disk(self):
        self.net_card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10); self.net_card.add_css_class("card")
        self.disk_card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10); self.disk_card.add_css_class("card")
        self.method_card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10); self.method_card.add_css_class("card")
        self.render_net(); self.render_disks(); self.render_methods()
        return self.page_box(lbl(self.L("disk_title"), "h1"), self.net_card, self.disk_card, self.method_card)

    # -- A. internet
    def refresh_net(self, rescan=False):
        def work():
            st = core.net_status()
            wl = core.wifi_list(rescan) if st.get("wifi_present") else []
            return st, wl
        def done(r):
            if isinstance(r, Exception): return
            self.c.net, self.wifi = r; self.render_net()
        bg(work, done)

    def render_net(self):
        while (ch := self.net_card.get_first_child()): self.net_card.remove(ch)
        st = self.c.net; wl = self.wifi
        self.net_card.append(lbl(self.L("sec_net"), "h2"))
        cls = "ok" if st.get("state") == "connected" else ("warn" if st.get("state") == "disconnected" else "err")
        self.net_card.append(lbl(st.get("text", ""), cls))
        for k in ("ethernet", "wifi"):
            if st.get(k): self.net_card.append(lbl(st[k], "small"))
        self.net_card.append(lbl("Internet is optional while you set things up, but the system files are downloaded during the installation, so the install needs a connection.", "small"))
        bar = Gtk.Box(spacing=10)
        r = Gtk.Button(label="Refresh"); r.connect("clicked", lambda _b: self.refresh_net(True)); bar.append(r)
        if st.get("wifi") and "connected to" in st["wifi"]:
            d = Gtk.Button(label="Disconnect Wi-Fi"); d.connect("clicked", lambda _b: bg(core.disconnect_wifi, lambda _r: self.refresh_net())); bar.append(d)
        self.net_card.append(bar)
        self.net_msg = lbl("", "small"); self.net_card.append(self.net_msg)
        if st.get("wifi_present"):
            if not wl: self.net_card.append(lbl("No Wi-Fi networks found yet. Press Refresh.", "small"))
            for w in wl[:8]:
                row = Gtk.Box(spacing=12); row.append(lbl("%s%s" % (w["ssid"], "  (connected)" if w["active"] else ""), wrap=False, hexpand=True))
                row.append(lbl("%d%%  %s" % (w["signal"], "Secured" if w["secure"] else "Open"), "small", wrap=False))
                b = Gtk.Button(label="Connect"); b.set_sensitive(not w["active"]); b.connect("clicked", lambda _b, w=w: self.wifi_dialog(w)); row.append(b)
                self.net_card.append(row)

    def wifi_dialog(self, w):
        entry = Gtk.Entry(visibility=False, placeholder_text="Wi-Fi password", width_request=320, activates_default=True)
        if not w["secure"]:
            self.net_msg.set_text("Connecting to %s…" % w["ssid"]); return self.wifi_go(w["ssid"], "")
        dlg = Gtk.Window(transient_for=self, modal=True, decorated=False, resizable=False); dlg.add_css_class("xl")
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, margin_top=22, margin_bottom=22, margin_start=26, margin_end=26)
        box.append(lbl("Connect to %s" % w["ssid"], "h2")); box.append(entry)
        bt = Gtk.Box(spacing=10, halign=Gtk.Align.END)
        c = Gtk.Button(label=self.L("cancel")); c.connect("clicked", lambda _b: dlg.close())
        ok = Gtk.Button(label="Connect"); ok.add_css_class("primary")
        def go(_b=None):
            pw = entry.get_text(); dlg.close(); self.net_msg.set_text("Connecting to %s…" % w["ssid"]); self.net_msg.remove_css_class("err"); self.wifi_go(w["ssid"], pw)
        ok.connect("clicked", go); entry.connect("activate", go)
        bt.append(c); bt.append(ok); box.append(bt); dlg.set_child(box); dlg.present(); entry.grab_focus()

    def wifi_go(self, ssid, pw):
        def done(r):
            ok, msg = r if not isinstance(r, Exception) else (False, str(r))
            self.net_msg.set_text(msg)
            if not ok: self.net_msg.add_css_class("err")
            self.refresh_net()
        bg(lambda: core.wifi_connect(ssid, pw), done)

    # -- B. disks
    def render_disks(self):
        while (ch := self.disk_card.get_first_child()): self.disk_card.remove(ch)
        self.disk_card.append(lbl(self.L("sec_disk"), "h2"))
        top = Gtk.Box(spacing=10)
        r = Gtk.Button(label="Refresh disks"); r.connect("clicked", lambda _b: self.rescan()); top.append(r); self.disk_card.append(top)
