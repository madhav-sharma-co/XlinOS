def desktop_info_for_class(cls):
    """Find the installed app that owns a window class (for running apps that are not pinned)."""
    c = (cls or "").lower()
    for a in Gio.AppInfo.get_all():
        try:
            wm = (a.get_string("StartupWMClass") or "").lower() if hasattr(a, "get_string") else ""
        except Exception:
            wm = ""
        aid = (a.get_id() or "").lower().replace(".desktop", "")
        if c and (c == wm or c == aid or aid.endswith("." + c)): return a
    return None

def make_dock(app):
    w = Gtk.ApplicationWindow(application=app)
    layer(w, LS.Layer.TOP, {LS.Edge.BOTTOM: True}, exclusive=84, margins={LS.Edge.BOTTOM: 12})   # windows and maximise stay above the run bar
    box = Gtk.Box(spacing=8); box.add_css_class("dock")
    state = {"dots": {}, "sig": None}
    pins = cfg.get("runbar_pins")
    known = {a[0]: a for a in xlinos_ui.available()}
    pinned = [known[i] for i in (list(known) if pins is None else pins) if i in known]
    pinned_cls = {a[5].lower() for a in pinned if a[5]}
    other_pins = []                         # pinned apps that are not XlinOS's own (pinned from the launcher)
    for i in ([] if pins is None else pins):
        if i in known: continue
        ai = Gio.DesktopAppInfo.new(i if i.endswith(".desktop") else i + ".desktop")
        if ai:
            wm = (ai.get_string("StartupWMClass") or i.replace(".desktop", "").split(".")[-1]).lower(); other_pins.append((i, ai, wm))
            if wm: pinned_cls.add(wm)

    def menu(btn, wmclass, cid, cmd, label, can_pin):
        pop = Gtk.Popover(); pop.set_parent(btn); pop.set_position(Gtk.PositionType.TOP); pop.set_has_arrow(False); pop.add_css_class("dockmenu")
        v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        def item(text, fn):
            it = Gtk.Button(label=text); it.add_css_class("sec"); it.set_halign(Gtk.Align.FILL)
            it.connect("clicked", lambda _b: (pop.popdown(), fn())); v.append(it)
        item("Open " + label, lambda: sh(cmd))
        if wmclass: item("Close", lambda: sh("hyprctl dispatch closewindow class:%s" % wmclass))
        if can_pin:
            now = pins is None or cid in (pins or [])
            item("Remove from the run bar" if now else "Keep on the run bar", lambda: (setpin(cid, not now)))
        pop.set_child(v); pop.popup()
    def setpin(cid, on):
        allids = [a[0] for a in xlinos_ui.available()]
        cur = list(allids if cfg.get("runbar_pins") is None else cfg.get("runbar_pins"))
        cur = [x for x in cur if x != cid]
        if on: cur.append(cid)
        cfg.set("runbar_pins", cur)
        GLib.idle_add(lambda: os.execv(sys.executable, [sys.executable] + sys.argv))   # restart this shell in place

    def add(cid, label, icon, cmd, wmclass, can_pin=True, gradient=True, gicon=None):
        col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, halign=Gtk.Align.CENTER)
        b = Gtk.Button(); b.add_css_class("dockbtn")
        t = Gtk.Box(halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER); t.add_css_class("apptile"); t.add_css_class("t-" + cid if gradient else "t-other")
        if gicon is not None: im = Gtk.Image.new_from_gicon(gicon)
        else: im = Gtk.Image.new_from_icon_name(icon)
        im.set_pixel_size(26)
        im.set_hexpand(True); im.set_vexpand(True); im.set_halign(Gtk.Align.CENTER); im.set_valign(Gtk.Align.CENTER)
        t.append(im); b.set_child(t); b.set_tooltip_text(label)
        b.connect("clicked", lambda _b: (cfg.push_recent(cid), sh("/usr/local/lib/xlinos/xlinos-focus '%s' %s" % (wmclass, cmd) if wmclass else cmd)))
        rc = Gtk.GestureClick(button=3); rc.connect("pressed", lambda g, n, x, y: menu(b, wmclass, cid, cmd, label, can_pin)); b.add_controller(rc)
        dot = Gtk.Box(halign=Gtk.Align.CENTER); dot.add_css_class("dot"); dot.set_opacity(0)
        col.append(b); col.append(dot); box.append(col)
        if wmclass: state["dots"][wmclass.lower()] = dot

    def build(extra):
        while (c := box.get_first_child()): box.remove(c)
        state["dots"] = {}
        for cid, label, icon, grad, cmd, wmc in pinned:
            add(cid, label, icon, cmd, wmc)
        for i, ai, wm in other_pins:
            add(i, ai.get_name(), "", "gtk-launch %s" % i.replace(".desktop", ""), wm, can_pin=True, gradient=False, gicon=ai.get_icon())
        for cls, ai in extra:        # running apps that are not pinned
            add("x-" + cls, ai.get_name(), "", "gtk-launch %s" % (ai.get_id() or ""), cls, can_pin=False, gradient=False, gicon=ai.get_icon())
        add("apps", "Apps", "view-app-grid-symbolic", "/usr/local/lib/xlinos/xlinos-launcher", "", can_pin=False)

    def running():
        clients = hypr("clients") or []
        cl = {(c.get("class") or "").lower() for c in clients}
        extra = []
        for c in sorted(cl):
            if not c or c in pinned_cls or c.startswith("os.xlin.") or c in ("", "xlinos-launcher"): continue
            ai = desktop_info_for_class(c)
            if ai: extra.append((c, ai))
        sig = tuple(c for c, _ in extra)
        if sig != state["sig"]:
            state["sig"] = sig; build(extra)
        for k, d in state["dots"].items():
            d.set_opacity(1 if k in cl else 0)
        return True
    running(); GLib.timeout_add(1500, running)
    w.set_child(box); w.present()

DESKTOP = os.path.expanduser("~/Desktop")

def desktop_resolve(i, known):
    if i in known:
        a = known[i]; return {"kind": "xapp", "id": i, "label": a[1], "icon": a[2], "cmd": a[4]}
    ai = Gio.DesktopAppInfo.new(i if i.endswith(".desktop") else i + ".desktop")
    if ai: return {"kind": "app", "id": i, "label": ai.get_name(), "gicon": ai.get_icon(), "cmd": "gtk-launch %s" % i.replace(".desktop", "")}
    return None

def desktop_entries():
    """Everything shown on the desktop: app shortcuts and app folders chosen by the user, then files and folders in ~/Desktop."""
    known = {a[0]: a for a in xlinos_ui.available()}
    items = []
    for i in cfg.desktop_icons():
        if isinstance(i, str):
            e = desktop_resolve(i, known)
            if e: items.append(e)
        else:
            kids = [e for e in (desktop_resolve(y, known) for y in i["items"]) if e]
            if kids: items.append({"kind": "folder", "id": "folder:" + i["folder"], "name": i["folder"], "label": i["folder"], "kids": kids})
    try:
        for n in sorted(os.listdir(DESKTOP), key=str.lower):
            if n.startswith("."): continue
            pth = os.path.join(DESKTOP, n)
            if n.endswith(".desktop"):
                ai = Gio.DesktopAppInfo.new_from_filename(pth)
                if ai: items.append({"kind": "file", "path": pth, "label": ai.get_name(), "gicon": ai.get_icon(), "cmd": "gtk-launch '%s'" % pth}); continue
            isd = os.path.isdir(pth)
            items.append({"kind": "dir" if isd else "file", "path": pth, "label": n, "icon": "folder-symbolic" if isd else "text-x-generic-symbolic",
                          "cmd": "xlinos-files '%s'" % pth if isd else "xdg-open '%s'" % pth})
    except OSError: pass
    return items

def make_desktop(app):
    w = Gtk.ApplicationWindow(application=app)
    layer(w, LS.Layer.BACKGROUND, {e: True for e in (LS.Edge.TOP, LS.Edge.BOTTOM, LS.Edge.LEFT, LS.Edge.RIGHT)})
    ov = Gtk.Overlay()
    for f in (cfg.get("wallpaper", "") or "", "/usr/share/xlinos/wallpapers/xlin-light.jpg" if cfg.is_light() else "/usr/share/xlinos/wallpapers/xlin-dark.jpg"):
        if f and os.path.exists(f):
            pic = Gtk.Picture.new_for_filename(f); pic.set_content_fit(Gtk.ContentFit.COVER); ov.set_child(pic); break
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, valign=Gtk.Align.START, halign=Gtk.Align.END, margin_top=52, margin_end=34)
    t = Gtk.Label(xalign=1); t.add_css_class("clock-time")
    d = Gtk.Label(xalign=1); d.add_css_class("clock-date")
    box.append(t); box.append(d)
    def tick():
        t.set_text(time.strftime("%H:%M")); d.set_text(time.strftime("%A, %d %B")); return True
    tick(); GLib.timeout_add_seconds(10, tick)
    if cfg.get("show_desktop_clock"): ov.add_overlay(box)

    # ---- icons: app shortcuts and files, like a normal desktop (double-click to open, right-click for a menu)
    try:
        mh = Gdk.Display.get_default().get_monitors().get_item(0).get_geometry().height
    except Exception:
        mh = 800
    rows = max(3, (mh - 38 - 84 - 40) // 100)
    flow = Gtk.FlowBox(orientation=Gtk.Orientation.VERTICAL, max_children_per_line=rows, min_children_per_line=1, selection_mode=Gtk.SelectionMode.NONE,
                       homogeneous=True, valign=Gtk.Align.START, halign=Gtk.Align.START, margin_top=50, margin_start=18, row_spacing=6, column_spacing=6)
    flow.set_hexpand(False); ov.add_overlay(flow)
    state = {"sig": None, "sel": None}
    def pop_at(parent, x, y, build):
        pop = Gtk.Popover(); pop.set_parent(parent); pop.set_has_arrow(False); pop.add_css_class("dmenu")
        r = Gdk.Rectangle(); r.x, r.y, r.width, r.height = int(x), int(y), 1, 1; pop.set_pointing_to(r)
        v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        def item(text, fn):
            b = Gtk.Button(label=text); b.set_halign(Gtk.Align.FILL); b.get_child().set_xalign(0)
            b.connect("clicked", lambda _b: (pop.popdown(), fn())); v.append(b)
        build(item, pop, v)
        pop.set_child(v); pop.connect("closed", lambda p: GLib.idle_add(p.unparent)); pop.popup()
    def refresh(force=False):
        items = desktop_entries()
        try: mt = os.stat(DESKTOP).st_mtime
        except OSError: mt = 0
        sig = (tuple((i.get("id") or i.get("path"), i["label"], tuple(k["id"] for k in i.get("kids", []))) for i in items), mt, rows)
        if sig == state["sig"] and not force: return True
        state["sig"] = sig
        while (c := flow.get_first_child()): flow.remove(c)
        for it in items: flow.append(make_icon(it))
        return True
    def new_folder():
        os.makedirs(DESKTOP, exist_ok=True)
        n, k = "New folder", 1
        while os.path.exists(os.path.join(DESKTOP, n)): k += 1; n = "New folder %d" % k
        os.makedirs(os.path.join(DESKTOP, n)); refresh(True)
    def add_app_menu(widget, x, y):
        def build(item, pop, v):
            sc = Gtk.ScrolledWindow(min_content_height=320, min_content_width=260); lst = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            have = cfg._all_ids()
            for a in sorted([a for a in Gio.AppInfo.get_all() if a.should_show()], key=lambda a: a.get_name().lower()):
                aid = a.get_id() or ""; nm = aid.replace(".desktop", "")
                key = "files" if False else (nm[7:] if nm.startswith("xlinos-") and nm[7:] in [q[0] for q in xlinos_ui.available()] else aid)
                if not aid or key in have: continue
                b = Gtk.Button(label=a.get_name()); b.get_child().set_xalign(0)
                b.connect("clicked", lambda _b, k=key: (pop.popdown(), cfg.add_desktop_icon(k), refresh(True))); lst.append(b)
            sc.set_child(lst); v.append(sc)
        pop_at(widget, x, y, build)
    def menu_desktop(widget, x, y):
        def build(item, pop, v):
            item("New folder", new_folder)
            item("Add an app to the desktop…", lambda: GLib.idle_add(add_app_menu, widget, x, y))
            item("Change the wallpaper", lambda: sh("xlinos-settings desktop"))
            item("Open Files", lambda: sh("xlinos-files"))
            item("Settings", lambda: sh("xlinos-settings"))
        pop_at(widget, x, y, build)
    def small_icon(e, px):
        if e["kind"] == "xapp": im = Gtk.Image.new_from_icon_name(e["icon"])
        elif e.get("gicon") is not None: im = Gtk.Image.new_from_gicon(e["gicon"])
        else: im = Gtk.Image.new_from_icon_name(e.get("icon", "application-x-executable-symbolic"))
        im.set_pixel_size(px); return im
    def open_folder(widget, it):
        pop = Gtk.Popover(); pop.set_parent(widget); pop.set_position(Gtk.PositionType.BOTTOM); pop.set_has_arrow(False); pop.add_css_class("dmenu")
        v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        name = Gtk.Entry(text=it["name"], width_chars=16); v.append(name)
        def done(*_):
            cfg.desktop_rename_folder(it["name"], name.get_text()); refresh(True)
        name.connect("activate", lambda *_: (done(), pop.popdown()))
        g = Gtk.FlowBox(max_children_per_line=3, min_children_per_line=1, selection_mode=Gtk.SelectionMode.NONE, homogeneous=True)
        for k in it["kids"]:
            c = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4, halign=Gtk.Align.CENTER); c.add_css_class("dicon"); c.set_size_request(84, 84)
            t = Gtk.Box(halign=Gtk.Align.CENTER); t.add_css_class("apptile")
            t.add_css_class("t-" + k["id"] if k["kind"] == "xapp" else "t-other"); t.append(small_icon(k, 28)); t.get_first_child().set_hexpand(True)
            l = Gtk.Label(label=k["label"], max_width_chars=11, ellipsize=3); l.add_css_class("dlabel"); c.append(t); c.append(l)
            def kopen(gc, n, x, y, k=k): gc.set_state(Gtk.EventSequenceState.CLAIMED); pop.popdown(); sh(k["cmd"])
            c1 = Gtk.GestureClick(button=1); c1.connect("released", kopen); c.add_controller(c1)
            def kout(gc, n, x, y, k=k):
                gc.set_state(Gtk.EventSequenceState.CLAIMED); pop.popdown(); cfg.desktop_take_out(k["id"]); refresh(True)
            c3 = Gtk.GestureClick(button=3); c3.connect("pressed", kout); c.add_controller(c3)
            g.append(c)
        v.append(g)
        hint = Gtk.Label(label="Click to open. Right-click an app to take it out of the folder.", wrap=True, max_width_chars=30); hint.add_css_class("dlabel"); v.append(hint)
        pop.set_child(v); pop.connect("closed", lambda p: (done(), GLib.idle_add(p.unparent))); pop.popup()
    def make_icon(it):
        col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4, halign=Gtk.Align.CENTER); col.add_css_class("dicon"); col.set_size_request(88, 92)
        tile = Gtk.Box(halign=Gtk.Align.CENTER); tile.add_css_class("apptile")
        if it["kind"] == "folder":
            tile.add_css_class("t-folder")
            grid = Gtk.Grid(halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER, row_spacing=3, column_spacing=3, hexpand=True, vexpand=True)
            for n, k in enumerate(it["kids"][:4]): grid.attach(small_icon(k, 20), n % 2, n // 2, 1, 1)
            tile.append(grid); im = None
        elif it["kind"] == "xapp": tile.add_css_class("t-" + it["id"]); im = Gtk.Image.new_from_icon_name(it["icon"])
        elif it.get("gicon") is not None: tile.add_css_class("t-other"); im = Gtk.Image.new_from_gicon(it["gicon"])
        else: tile.add_css_class("t-files" if it["kind"] == "dir" else "t-other"); im = Gtk.Image.new_from_icon_name(it["icon"])
        if im is not None: im.set_pixel_size(28); im.set_hexpand(True); im.set_vexpand(True); tile.append(im)
        lb = Gtk.Label(label=it["label"], max_width_chars=12, ellipsize=3, justify=Gtk.Justification.CENTER); lb.add_css_class("dlabel")
        col.append(tile); col.append(lb)
        def click(g, n, x, y):
            g.set_state(Gtk.EventSequenceState.CLAIMED)
            if state["sel"] is not None: state["sel"].remove_css_class("sel")
            col.add_css_class("sel"); state["sel"] = col
            if n >= 2:
                if it["kind"] == "folder": open_folder(col, it)
                else: cfg.push_recent(it.get("id") or ""); sh(it["cmd"])
        g1 = Gtk.GestureClick(button=1); g1.connect("pressed", click); col.add_controller(g1)
        def rclick(g, n, x, y):
            g.set_state(Gtk.EventSequenceState.CLAIMED)
            def build(item, pop, v):
                if it["kind"] == "folder":
                    item("Open", lambda: GLib.idle_add(open_folder, col, it))
                    item("Undo the folder (apps go back to the desktop)", lambda: (cfg.desktop_dissolve_folder(it["name"]), refresh(True)))
                    return
                item("Open", lambda: sh(it["cmd"]))
                if it["kind"] in ("xapp", "app"): item("Remove from the desktop", lambda: (cfg.remove_desktop_icon(it["id"]), refresh(True)))
                else: item("Move to Trash", lambda: (sh("gio trash '%s'" % it["path"]), GLib.timeout_add(600, lambda: (refresh(True), False)[1])))
            pop_at(col, x, y, build)
        g3 = Gtk.GestureClick(button=3); g3.connect("pressed", rclick); col.add_controller(g3)
        # drag an app onto another app: they become a folder; onto a folder: it goes in
        if it["kind"] in ("xapp", "app"):
            ds = Gtk.DragSource(); ds.set_actions(Gdk.DragAction.MOVE)
            ds.connect("prepare", lambda s_, x, y: Gdk.ContentProvider.new_for_value(it["id"]))
            ds.connect("drag-begin", lambda s_, d: s_.set_icon(Gtk.WidgetPaintable.new(tile), 26, 26)); col.add_controller(ds)
        if it["kind"] in ("xapp", "app", "folder"):
            dt = Gtk.DropTarget.new(str, Gdk.DragAction.MOVE)
            dt.connect("enter", lambda t_, x, y: (col.add_css_class("sel"), Gdk.DragAction.MOVE)[1]); dt.connect("leave", lambda t_: col.remove_css_class("sel"))
            def dropped(t_, val, x, y):
                col.remove_css_class("sel"); cfg.desktop_drop(val, it["id"]); GLib.idle_add(refresh, True); return True
            dt.connect("drop", dropped); col.add_controller(dt)
        return col
    bgc = Gtk.GestureClick(button=3); bgc.connect("pressed", lambda g, n, x, y: menu_desktop(ov, x, y)); ov.add_controller(bgc)
    bg1 = Gtk.GestureClick(button=1)
    def bg_click(g, n, x, y):
        if state["sel"] is not None: state["sel"].remove_css_class("sel"); state["sel"] = None
    bg1.connect("pressed", bg_click); ov.add_controller(bg1)
    refresh(True); GLib.timeout_add(2000, refresh)
    w.set_child(ov); w.present()

def activate(app):
    p = Gtk.CssProvider(); p.load_from_data(css_bytes())
    Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), p, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    make_desktop(app); make_bar(app); make_dock(app)

app = Gtk.Application(application_id="os.xlin.shell")
app.connect("activate", activate)
sys.exit(app.run(None))
