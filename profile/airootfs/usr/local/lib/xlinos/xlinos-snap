#!/usr/bin/env python3
"""XlinOS window snapping. usage: xlinos-snap press|drop|left|right|up|down|center|tl|tr|bl|br|max|restore
Left/Right: half of the screen. Up: maximize (from a half: top quarter). Down: restore (from a half: bottom quarter).
Windows float, so this only moves and resizes the active window; it remembers the old size for "restore"."""
import json, os, subprocess, sys

GAP = 12
STATE = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "xlinos-snap.json")


def hc(*a):
    return subprocess.run(["hyprctl", *a], capture_output=True, text=True, timeout=4).stdout


def lua(code):
    return subprocess.run(["hyprctl", "eval", code], capture_output=True, text=True, timeout=4).stdout.strip()


def zone_for(cx, cy, mw, mh):
    """Which snap spot a cursor at (cx, cy) on the screen points to, or None."""
    E_, C_ = 6, 90
    l, r_, t, b = cx <= E_, cx >= mw - 1 - E_, cy <= E_, cy >= mh - 1 - E_
    if (t and cx <= C_) or (l and cy <= C_): return "tl"
    if (t and cx >= mw - C_) or (r_ and cy <= C_): return "tr"
    if (b and cx <= C_) or (l and cy >= mh - C_): return "bl"
    if (b and cx >= mw - C_) or (r_ and cy >= mh - C_): return "br"
    if t: return "max"
    if l: return "left"
    if r_: return "right"
    return None


def load():
    try:
        return json.load(open(STATE))
    except Exception:
        return {}


PIDF = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "xlinos-snap-watch.pid")
PREVIEW = "/usr/local/lib/xlinos/xlinos-preview"


def stop_watch():
    try:
        pid = int(open(PIDF).read()); os.remove(PIDF)
        os.kill(pid, 15)
    except Exception:
        pass
    subprocess.run(["pkill", "-f", "lib/xlinos/xlinos-preview"], capture_output=True)


def watch(win, addr, mx, my, mw, mh, spots):
    import time
    open(PIDF, "w").write(str(os.getpid()))
    pr = load().get("_press") or {}
    start = (pr.get("at", win["at"]), pr.get("size", win["size"])); shown = None; proc = None
    t0 = time.time()
    n = 0
    old = (load().get(addr) or {}).get("old")        # the window is snapped: dragging it out gives its old size back
    while time.time() - t0 < 120:
        time.sleep(0.05)
        cur = json.loads(hc("activewindow", "-j") or "{}")
        n += 1
        if n % 20 == 1:
            print("watch", cur.get("address") == addr, cur.get("at"), start[0], hc("cursorpos", "-j").replace("\n", " "), file=sys.stderr, flush=True)
        moved = cur.get("address") == addr and (cur.get("at"), cur.get("size")) != start
        cp = json.loads(hc("cursorpos", "-j") or "{}")
        if moved and old:
            ox, oy, ow, oh = old; old = None
            wx, wy, ww0 = cur["at"][0], cur["at"][1], max(cur["size"][0], 1)
            fx = min(max((cp.get("x", wx) - wx) / ww0, 0.1), 0.9)
            nx, ny = int(cp.get("x", wx) - fx * ow), int(min(cp.get("y", wy), wy + 24))
            sel = f'window = "address:{addr}"'
            lua(f"hl.dispatch(hl.dsp.window.resize({{ {sel}, x = {ow}, y = {oh} }}))")
            lua(f"hl.dispatch(hl.dsp.window.move({{ {sel}, x = {nx}, y = {ny} }}))")
            st2 = load(); st2.pop(addr, None); json.dump(st2, open(STATE, "w"))
            start = (cur.get("at"), cur.get("size"))
            moved = False
        z = zone_for(cp.get("x", -1) - mx, cp.get("y", -1) - my, mw, mh) if moved else None
        if z != shown:
            if proc: proc.terminate(); proc = None
            print("zone", z, file=sys.stderr, flush=True)
            if z:
                x, y, w, h = spots[z]
                proc = subprocess.Popen([PREVIEW, str(x), str(y), str(w), str(h)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            shown = z
    if proc: proc.terminate()
    return 0


def main(action):
    win = json.loads(hc("activewindow", "-j") or "{}")
    addr = win.get("address")
    if not addr:
        return 0
    mon = next((m for m in json.loads(hc("monitors", "-j")) if m["id"] == win["monitor"]), None)
    if mon is None:
        return 0
    sc = mon.get("scale", 1) or 1
    mx, my, mw, mh = mon["x"], mon["y"], int(mon["width"] / sc), int(mon["height"] / sc)
    rl, rt, rr, rb = (mon.get("reserved") or [0, 0, 0, 0])[:4]       # left, top, right, bottom (bar, dock)
    x0, y0 = mx + rl + GAP, my + rt + GAP
    w, h = mw - rl - rr - 2 * GAP, mh - rt - rb - 2 * GAP
    hw, hh = (w - GAP) // 2, (h - GAP) // 2
    spots = {
        "left": (x0, y0, hw, h), "right": (x0 + hw + GAP, y0, hw, h),
        "max": (x0, y0, w, h),
        "tl": (x0, y0, hw, hh), "tr": (x0 + hw + GAP, y0, hw, hh),
        "bl": (x0, y0 + hh + GAP, hw, hh), "br": (x0 + hw + GAP, y0 + hh + GAP, hw, hh),
        "center": (x0 + w // 6, y0 + h // 8, w * 2 // 3, h * 3 // 4),
    }
    if action == "watch":                       # runs while the button is held: shows where the window would snap
        return watch(win, addr, mx, my, mw, mh, spots)
    st = load()
    if action == "press":                       # mouse button went down: remember where the window is
        st["_press"] = {"addr": addr, "at": win["at"], "size": win["size"]}
        json.dump(st, open(STATE, "w"))
        stop_watch()
        subprocess.Popen([sys.argv[0], "watch"], start_new_session=True, stdout=subprocess.DEVNULL, stderr=open(os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "xlinos-snap-watch.log"), "w"))
        return 0
    if action == "drop":
        stop_watch()                        # mouse button released: if the window was dragged to a screen edge, snap it
        pr = st.get("_press") or {}
        if pr.get("addr") != addr or (pr.get("at") == win["at"] and pr.get("size") == win["size"]):
            return 0
        cp = json.loads(hc("cursorpos", "-j") or "{}")
        cx, cy = cp.get("x", -1) - mx, cp.get("y", -1) - my
        action = zone_for(cx, cy, mw, mh)
        if action is None: return 0
        st.pop("_press", None)
    cur = st.get(addr, {})
    last = cur.get("last")
    # arrows: the second key refines the first one
    if action == "up":
        action = {"left": "tl", "right": "tr", "tl": "max", "tr": "max"}.get(last, "max")
    elif action == "down":
        action = {"left": "bl", "right": "br", "tl": "left", "tr": "right", "bl": "restore", "br": "restore"}.get(last, "restore")
    if action == "restore" and last in (None, "restore", "center") and not cur.get("old"):
        action = "center"
    if action == "restore":
        old = cur.get("old")
        if not old:
            return 0
        x, y, ww, hh2 = old
        st.pop(addr, None)
    else:
        if action not in spots:
            return 1
        x, y, ww, hh2 = spots[action]
        if "old" not in cur and action != "center":
            cur["old"] = [win["at"][0], win["at"][1], win["size"][0], win["size"][1]]
        cur["last"] = action
        st[addr] = cur
    if not win.get("floating"):
        lua('hl.dispatch(hl.dsp.window.float({ action = "toggle" }))')
    sel = f'window = "address:{addr}"'
    out1 = lua(f"hl.dispatch(hl.dsp.window.resize({{ {sel}, x = {ww}, y = {hh2} }}))")
    out2 = lua(f"hl.dispatch(hl.dsp.window.move({{ {sel}, x = {x}, y = {y} }}))")
    try:
        json.dump(st, open(STATE, "w"))
    except OSError:
        pass
    if os.environ.get("XLINOS_DEBUG"):
        print(action, (x, y, ww, hh2), out1, out2)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1] if len(sys.argv) > 1 else ""))
