#!/usr/bin/env python3
"""XlinOS window snapping via xlin-comp (left|right|up|down|top|bottom|tl|tr|bl|br|max|restore|center)."""
import subprocess, sys

VALID = {"left", "right", "up", "down", "top", "bottom", "tl", "tr", "bl", "br", "max", "restore", "center"}
act = sys.argv[1] if len(sys.argv) > 1 else ""
if act in VALID:
    sys.exit(subprocess.call(["xlinctl", "snap", act]))
if act in ("press", "drop", "watch"):
    sys.exit(0)
sys.stderr.write("usage: xlinos-snap left|right|up|down|top|bottom|tl|tr|bl|br|max|restore|center\n")
sys.exit(1)
