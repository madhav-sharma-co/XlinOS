#!/usr/bin/env python3
"""XlinOS status-bar menus: xlinos-menu wifi | bluetooth | sound. A small glass popup under the status bar."""
import os, sys, subprocess, threading, re

LIB = "/usr/lib/libgtk4-layer-shell.so"
if os.path.exists(LIB) and LIB not in os.environ.get("LD_PRELOAD", ""):
    os.environ["LD_PRELOAD"] = (os.environ.get("LD_PRELOAD", "") + " " + LIB).strip()
    os.execv(sys.executable, [sys.executable] + sys.argv)

import gi
gi.require_version("Gtk", "4.0")
gi.require_version("Gtk4LayerShell", "1.0")
from gi.repository import Gtk, Gdk, GLib, Gtk4LayerShell as LS

KIND = (sys.argv[1] if len(sys.argv) > 1 else "wifi").lower()
CSS = b"""
window { background: transparent; }
.panel { background: rgba(10,18,52,0.96); border: 1px solid rgba(255,255,255,0.14); border-radius: 18px; padding: 14px; color: #fff; min-width: 330px; }
.title { font-size: 16px; font-weight: 700; }
.hint { color: #9db4e6; font-size: 12px; }
.err { color: #ff9a9a; font-size: 12px; }
.row { background: transparent; border: none; box-shadow: none; color: #fff; border-radius: 12px; padding: 9px 10px; min-height: 22px; }
.row:hover { background: rgba(255,255,255,0.10); }
.row.on { background: rgba(30,107,255,0.35); }
.pill { background: rgba(255,255,255,0.10); border: none; box-shadow: none; color: #fff; border-radius: 12px; padding: 7px 14px; min-height: 20px; }
.pill:hover { background: rgba(255,255,255,0.18); }
.pill.go { background: #1e6bff; }
entry { background: rgba(255,255,255,0.10); color: #fff; border-radius: 10px; border: 1px solid rgba(255,255,255,0.16); padding: 6px 10px; min-height: 20px; }
switch { background: rgba(255,255,255,0.18); border-radius: 14px; border: none; }
switch:checked { background: #1e6bff; }
switch slider { background: #fff; border-radius: 12px; border: none; }
scale { min-height: 14px; }
scale trough { background: rgba(255,255,255,0.16); background-image: none; min-height: 6px; border-radius: 3px; border: none; }
