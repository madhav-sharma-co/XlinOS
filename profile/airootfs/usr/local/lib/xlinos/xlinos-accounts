#!/usr/bin/env python3
"""XlinOS account helper. Runs as root (through sudo, from the login screen, which runs as an unprivileged user).
Reads one JSON request on stdin and prints one JSON answer on stdout.

  {"cmd":"list"}
  {"cmd":"create","name":"ann","fullname":"Ann Lee","password":"...","admin":true,"auth":{"user":"bob","password":"..."}}
  {"cmd":"delete","name":"ann","purge":false,"auth":{"user":"ann","password":"..."}}

Rules (decided by the CEO):
  - The first user is created without authentication and is always an admin.
  - Later users need an admin's password. Standard users unless "admin" is true.
  - Deleting a user needs that user's own password or an admin's. Files are kept unless "purge" is true.
  - The last admin and logged-in users cannot be deleted.
"""
import ctypes, ctypes.util, grp, hmac, json, os, pwd, re, subprocess, sys, time

MIN_UID, MAX_UID = 1000, 60000
NAME_RE = re.compile(r"^[a-z_][a-z0-9_-]{0,30}$")
EXTRA_GROUPS = ("video", "audio", "input", "storage", "optical", "network")


class Fail(Exception):
    def __init__(self, code, message):
        super().__init__(message)
        self.code, self.message = code, message


def humans():
    return [p for p in pwd.getpwall()
            if MIN_UID <= p.pw_uid < MAX_UID and not p.pw_shell.endswith(("nologin", "false"))]


def is_admin(name):
    try:
        wheel = grp.getgrnam("wheel")
        return name in wheel.gr_mem or pwd.getpwnam(name).pw_gid == wheel.gr_gid
    except KeyError:
        return False


def shadow_hash(name):
    with open("/etc/shadow") as f:
        for line in f:
            parts = line.rstrip("\n").split(":")
            if parts[0] == name:
                return parts[1]
    return ""


def check_password(name, password):
    """True if password is right for name. Uses libcrypt, so every hash type the system uses works."""
    h = shadow_hash(name)
    if not h or h[0] in "!*":
        return False
    lib = ctypes.CDLL(ctypes.util.find_library("crypt") or "libcrypt.so.2")
    lib.crypt.restype, lib.crypt.argtypes = ctypes.c_char_p, [ctypes.c_char_p, ctypes.c_char_p]
    out = lib.crypt(password.encode(), h.encode())
    return bool(out) and hmac.compare_digest(out.decode(), h)


def authenticate(auth):
    if not isinstance(auth, dict) or not auth.get("user") or not isinstance(auth.get("password"), str):
        raise Fail("auth_failed", "Enter a password.")
    if not check_password(auth["user"], auth["password"]):
        time.sleep(1)  # slow down guessing
        raise Fail("auth_failed", "Wrong password.")
    return auth["user"]


def need_admin(auth):
    user = authenticate(auth)
    if not is_admin(user):
        raise Fail("not_admin", "That user is not an administrator.")
    return user


def logged_in(uid):
    return subprocess.run(["pgrep", "-u", str(uid)], capture_output=True).returncode == 0


def cmd_list(_):
    return {"users": [{"name": p.pw_name, "fullname": p.pw_gecos.split(",")[0] or p.pw_name,
                       "admin": is_admin(p.pw_name), "uid": p.pw_uid} for p in humans()]}


def cmd_create(req):
    name, fullname, password = req.get("name", ""), (req.get("fullname") or "").strip(), req.get("password", "")
    first = not humans()
    if not first:
        need_admin(req.get("auth"))
    if not NAME_RE.match(name):
        raise Fail("bad_name", "User names use lowercase letters, numbers, - and _, and start with a letter.")
    try:
        pwd.getpwnam(name)
        raise Fail("exists", "That user name is taken.")
    except KeyError:
        pass
    if not isinstance(password, str) or len(password) < 4 or "\n" in password:
        raise Fail("bad_password", "Use a password with at least 4 characters.")
    if any(c in fullname for c in ":\n,") or len(fullname) > 60:
        raise Fail("bad_name", "The full name cannot contain : or , or be that long.")
    admin = True if first else bool(req.get("admin"))
    groups = [g for g in (("wheel",) if admin else ()) + EXTRA_GROUPS if _group_exists(g)]
    cmd = ["useradd", "-m", "-s", "/bin/bash", "-c", fullname or name]
    if groups:
        cmd += ["-G", ",".join(groups)]
    r = subprocess.run(cmd + [name], capture_output=True, text=True)
    if r.returncode:
        raise Fail("failed", "Could not create the user: " + r.stderr.strip())
    r = subprocess.run(["chpasswd"], input=f"{name}:{password}\n", capture_output=True, text=True)
    if r.returncode:
        subprocess.run(["userdel", "-r", name], capture_output=True)
        raise Fail("failed", "Could not set the password: " + r.stderr.strip())
    return {"name": name, "admin": admin}


def _group_exists(g):
    try:
        grp.getgrnam(g)
        return True
    except KeyError:
        return False


def cmd_delete(req):
    name = req.get("name", "")
    try:
        p = pwd.getpwnam(name)
    except KeyError:
        raise Fail("no_user", "That user does not exist.")
    if p not in humans():
        raise Fail("no_user", "That user cannot be deleted here.")
    who = authenticate(req.get("auth"))
    if who != name and not is_admin(who):
        raise Fail("not_admin", "Use the password of this user or of an administrator.")
    if is_admin(name) and sum(1 for h in humans() if is_admin(h.pw_name)) < 2:
        raise Fail("last_admin", "This is the last administrator. Make another user an administrator first.")
    if logged_in(p.pw_uid):
        raise Fail("logged_in", "This user is logged in. Log out first.")
    r = subprocess.run(["userdel"] + (["-r"] if req.get("purge") else []) + [name], capture_output=True, text=True)
    if r.returncode:
        raise Fail("failed", "Could not delete the user: " + r.stderr.strip())
    return {"name": name, "purged": bool(req.get("purge"))}


COMMANDS = {"list": cmd_list, "create": cmd_create, "delete": cmd_delete}


def main():
    try:
        if os.geteuid() != 0:
            raise Fail("not_root", "This helper must run as root.")
        req = json.loads(sys.stdin.read() or "{}")
        fn = COMMANDS.get(req.get("cmd"))
        if not fn:
            raise Fail("bad_request", "Unknown command.")
        out = {"ok": True, **fn(req)}
    except Fail as e:
        out = {"ok": False, "error": e.code, "message": e.message}
    except Exception as e:  # never leak a traceback with secrets to the screen
        out = {"ok": False, "error": "failed", "message": "Unexpected error: %s" % type(e).__name__}
    print(json.dumps(out))


if __name__ == "__main__":
    main()
