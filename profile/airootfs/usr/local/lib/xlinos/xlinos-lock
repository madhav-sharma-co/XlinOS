#!/usr/bin/env python3
"""XlinOS lock screen: wallpaper, clock, password, and a Log out button. Uses ext-session-lock (apps keep running)."""
import os, sys, time, getpass, threading, ctypes, subprocess
from ctypes import c_int, c_char_p, c_void_p, POINTER, Structure, CFUNCTYPE, byref, cast

def fallback():
    os.execvp("hyprlock", ["hyprlock", "-c", "/usr/share/xlinos/hyprlock.conf"])

try:
    import gi
    gi.require_version("Gtk", "3.0")
    gi.require_version("Gdk", "3.0")
    gi.require_version("GtkSessionLock", "0.1")
    from gi.repository import Gtk, Gdk, GLib, GtkSessionLock as SL
    if not SL.is_supported():
        raise RuntimeError("no ext-session-lock")
except Exception as e:
    print("lock fallback:", e, file=sys.stderr)
    fallback()

USER = getpass.getuser()
WALL = "/usr/share/xlinos/wallpapers/xlin-dark.jpg"

# ---- password check through PAM ----
libc = ctypes.CDLL("libc.so.6"); libc.calloc.restype = c_void_p; libc.strdup.restype = c_void_p
pam = ctypes.CDLL("libpam.so.0")
class PamMsg(Structure): _fields_ = [("style", c_int), ("msg", c_char_p)]
class PamResp(Structure): _fields_ = [("resp", c_void_p), ("code", c_int)]
CONV = CFUNCTYPE(c_int, c_int, POINTER(POINTER(PamMsg)), POINTER(POINTER(PamResp)), c_void_p)
class PamConv(Structure): _fields_ = [("conv", CONV), ("data", c_void_p)]

def check(password):
    pw = password.encode()
    def conv(n, msgs, resp, _d):
        arr = libc.calloc(n, ctypes.sizeof(PamResp))
        resp[0] = cast(arr, POINTER(PamResp))
        for i in range(n):
            if msgs[i][0].style in (1, 2):      # prompt (echo off / on)
                resp[0][i].resp = libc.strdup(pw)
        return 0
    cb = CONV(conv); c = PamConv(cb, None); h = c_void_p()
    if pam.pam_start(b"login", USER.encode(), byref(c), byref(h)) != 0:
        return False
    ok = pam.pam_authenticate(h, 0) == 0
    pam.pam_end(h, 0)
    return ok

CSS = b"""/*nolight*/
window { background-color: #03081c; }
label { color: #ffffff; }
.time { font-size: 96px; font-weight: 200; }
.date { font-size: 20px; color: #9db4e6; }
.avatar { background-color: #1e6bff; border-radius: 44px; min-width: 88px; min-height: 88px; }
.avatar label { font-size: 32px; font-weight: 700; }
.user { font-size: 20px; font-weight: 700; margin: 10px 0 14px 0; }
.msg { color: #ff8a8a; font-size: 13px; }
entry { background: rgba(12,20,56,0.85); color: #fff; border: 1px solid rgba(255,255,255,0.18); border-radius: 12px; padding: 0 16px; min-height: 48px; box-shadow: none; }
entry:focus { border-color: #4f93ff; }
button.login { background-image: none; background-color: #1e6bff; color: #fff; border: none; box-shadow: none; border-radius: 12px; padding: 0 12px; min-height: 48px; font-weight: 600; }
button.login:hover { background-color: #3b82ff; }
button.link { background-image: none; background-color: transparent; color: #9db4e6; border: none; box-shadow: none; border-radius: 12px; min-height: 36px; padding: 0 18px; }
button.link:hover { color: #fff; background-color: rgba(255,255,255,0.08); }
"""

lock = SL.prepare_lock()
state = {"windows": []}

def unlock():
    lock.unlock_and_destroy()
    Gdk.Display.get_default().sync()
    Gtk.main_quit()

def build(monitor, primary):
    win = Gtk.Window()
    ov = Gtk.Overlay()
    try:
        from gi.repository import GdkPixbuf
        geo = monitor.get_geometry()
        pb = GdkPixbuf.Pixbuf.new_from_file(WALL)
        s = max(geo.width / pb.get_width(), geo.height / pb.get_height())
        pb = pb.scale_simple(int(pb.get_width() * s), int(pb.get_height() * s), GdkPixbuf.InterpType.BILINEAR)
        x0 = max(0, (pb.get_width() - geo.width) // 2); y0 = max(0, (pb.get_height() - geo.height) // 2)
        pb = pb.new_subpixbuf(x0, y0, min(geo.width, pb.get_width()), min(geo.height, pb.get_height()))  # crop to the screen so the surface is not wider than it
        ov.add(Gtk.Image.new_from_pixbuf(pb))
    except Exception:
        pass
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10, halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER)
    t = Gtk.Label(); t.get_style_context().add_class("time")
    d = Gtk.Label(); d.get_style_context().add_class("date")
    box.pack_start(t, False, False, 0); box.pack_start(d, False, False, 0)
    def tick():
        t.set_text(time.strftime("%H:%M")); d.set_text(time.strftime("%A, %-d %B")); return True
    tick(); GLib.timeout_add_seconds(5, tick)
    if primary:
        try:
            import pwd
            full = pwd.getpwnam(USER).pw_gecos.split(",")[0] or USER
        except Exception:
            full = USER
        av = Gtk.Box(halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER); av.set_size_request(88, 88); av.get_style_context().add_class("avatar"); av.set_margin_top(30)
        al = Gtk.Label(label=full[:1].upper(), halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER, hexpand=True, vexpand=True); av.add(al)
        u = Gtk.Label(label=full); u.get_style_context().add_class("user")
        e = Gtk.Entry(visibility=False, halign=Gtk.Align.CENTER); e.set_alignment(0.0); e.set_size_request(320, 48)
        e.set_placeholder_text("Password")
        e.set_icon_from_icon_name(Gtk.EntryIconPosition.SECONDARY, "view-reveal-symbolic")
        e.connect("icon-press", lambda en, pos, ev: en.set_visibility(not en.get_visibility()))
        m = Gtk.Label(); m.get_style_context().add_class("msg")
        btn = Gtk.Button(label="Login", halign=Gtk.Align.CENTER); btn.set_size_request(320, 48); btn.get_style_context().add_class("login")
        sw = Gtk.Button(label="Log out / Switch user", halign=Gtk.Align.CENTER); sw.set_margin_top(6); sw.get_style_context().add_class("link")
        sw.connect("clicked", lambda _b: subprocess.Popen(["xlinos-logout"]))   # ends the session; the screen stays locked until the login screen appears
        def done(ok):
            if ok: unlock()
            else:
                e.set_sensitive(True); btn.set_sensitive(True); e.set_text(""); m.set_text("Wrong password. Try again."); e.grab_focus()
            return False
        def go(_w):
            pw = e.get_text()
            if not pw: return
            e.set_sensitive(False); btn.set_sensitive(False); m.set_text("")
            threading.Thread(target=lambda: GLib.idle_add(done, check(pw)), daemon=True).start()
        e.connect("activate", go); btn.connect("clicked", go)
        pw_row = Gtk.Box(spacing=6, halign=Gtk.Align.CENTER)
        for text, cmd in (("Restart", ["systemctl", "reboot"]), ("Shut down", ["systemctl", "poweroff"])):
            b2 = Gtk.Button(label=text); b2.get_style_context().add_class("link"); b2.connect("clicked", lambda _b, c=cmd: subprocess.Popen(c)); pw_row.pack_start(b2, False, False, 0)
        for w_ in (av, u, e, m, btn, sw, pw_row): box.pack_start(w_, False, False, 0)
        GLib.idle_add(e.grab_focus)
    ov.add_overlay(box); win.add(ov)
    lock.new_surface(win, monitor); win.show_all()
    state["windows"].append(win)

p = Gtk.CssProvider(); p.load_from_data(CSS)
Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), p, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
lock.connect("finished", lambda *_: Gtk.main_quit())
lock.lock_lock()
disp = Gdk.Display.get_default()
for i in range(disp.get_n_monitors()):
    build(disp.get_monitor(i), i == 0)
Gtk.main()
