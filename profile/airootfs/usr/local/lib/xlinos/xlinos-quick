#!/usr/bin/env python3
"""XlinOS quick settings: glass panel with Wi-Fi, Bluetooth, volume, brightness, battery, Log out, Restart, Shut down."""
import os, sys, subprocess, getpass, glob

LIB = "/usr/lib/libgtk4-layer-shell.so"
if os.path.exists(LIB) and LIB not in os.environ.get("LD_PRELOAD", ""):
    os.environ["LD_PRELOAD"] = (os.environ.get("LD_PRELOAD", "") + " " + LIB).strip()
    os.execv(sys.executable, [sys.executable] + sys.argv)
# the preload is only for this program: apps it starts (Firefox, ...) must not inherit it
if LIB in os.environ.get("LD_PRELOAD", ""):
    _rest = os.environ["LD_PRELOAD"].replace(LIB, "").split()
    if _rest: os.environ["LD_PRELOAD"] = " ".join(_rest)
    else: os.environ.pop("LD_PRELOAD", None)

import gi
gi.require_version("Gtk", "4.0")
gi.require_version("Gtk4LayerShell", "1.0")
from gi.repository import Gtk, Gdk, Gio, Gtk4LayerShell as LS
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import xlinos_cfg

CSS = b"""
window { background: transparent; }
.panel { background: rgba(10,18,52,0.94); border: 1px solid rgba(255,255,255,0.14); border-radius: 22px; padding: 18px; color: #fff; min-width: 340px; }
.name { font-size: 18px; font-weight: 700; margin-bottom: 4px; }
.sub { margin-bottom: 6px; }
.sub { color: #9db4e6; font-size: 12px; }
.toggle { background-image: none; background-color: rgba(255,255,255,0.08); box-shadow: none; color: #fff; border: none; border-radius: 12px; min-height: 22px; padding: 11px 14px; }
.toggle:hover { background-color: rgba(255,255,255,0.14); }
.toggle.on:hover { background-color: #3a80ff; }
.toggle.on { background-color: #1e6bff; }
.toggle:checked { background-color: #1e6bff; }
.act { background-image: none; background-color: rgba(255,255,255,0.08); box-shadow: none; color: #fff; border: none; border-radius: 12px; min-height: 22px; padding: 11px 8px; }
.act:hover { background-color: rgba(255,255,255,0.16); }
.act:checked { background-color: #1e6bff; }
.danger { background-color: rgba(255,80,80,0.22); }
scale { min-height: 14px; margin: 0; padding: 0; }
scale trough { background: rgba(255,255,255,0.16); background-image: none; min-height: 6px; border-radius: 3px; border: none; box-shadow: none; outline: none; }
scale highlight { background: #1e6bff; background-image: none; border-radius: 3px; border: none; outline: none; }
scale slider { background: #fff; min-width: 18px; min-height: 18px; border-radius: 9px; border: none; box-shadow: 0 1px 4px rgba(0,0,0,0.35); margin: -6px; }
"""

def run(cmd):
    try:
        return subprocess.run(cmd, shell=True, capture_output=True, text=True, timeout=3).stdout.strip()
    except Exception:
        return ""

def bg(cmd):
    subprocess.Popen(cmd, shell=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)

def battery():
    for d in glob.glob("/sys/class/power_supply/BAT*"):
        try:
            return int(open(d + "/capacity").read()), open(d + "/status").read().strip()
        except Exception:
            pass
    return None

def full_name():
    u = getpass.getuser()
    try:
        import pwd
        g = pwd.getpwnam(u).pw_gecos.split(",")[0]
        return g or u
    except Exception:
        return u

def slider(label, get, set_):
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
    l = Gtk.Label(label=label, xalign=0); l.add_css_class("sub")
    s = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1); s.set_value(get())
    s.connect("value-changed", lambda sc: set_(int(sc.get_value())))
    box.append(l); box.append(s); return box

def activate(app):
    p = Gtk.CssProvider(); p.load_from_data(xlinos_cfg.themed(CSS))
    Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), p, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    w = Gtk.ApplicationWindow(application=app)
    LS.init_for_window(w); LS.set_layer(w, LS.Layer.OVERLAY); LS.set_namespace(w, "xlinos-quick")
    LS.set_anchor(w, LS.Edge.TOP, True); LS.set_anchor(w, LS.Edge.RIGHT, True)
    LS.set_margin(w, LS.Edge.TOP, 44); LS.set_margin(w, LS.Edge.RIGHT, 12)
    LS.set_keyboard_mode(w, LS.KeyboardMode.ON_DEMAND)

    root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16); root.add_css_class("panel")
    head = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
    n = Gtk.Label(label=full_name(), xalign=0); n.add_css_class("name")
    b = battery()
    sub = Gtk.Label(label=("Battery %d%%  %s" % b) if b else "Plugged in", xalign=0); sub.add_css_class("sub")
    head.append(n); head.append(sub); root.append(head)

    grid = Gtk.Grid(column_spacing=8, row_spacing=8, column_homogeneous=True)
    def toggle(text, state, on, off):
        t = Gtk.ToggleButton(label=text); t.add_css_class("toggle"); t.set_active(state)
        if state: t.add_css_class("on")
        def ch(btn):
            a = btn.get_active(); (on if a else off)()
            (btn.add_css_class if a else btn.remove_css_class)("on")
        t.connect("toggled", ch); return t
    vol0, muted0 = xlinos_cfg.volume()
    items = [
        ("Wi-Fi", xlinos_cfg.wifi_on(), lambda: xlinos_cfg.bg("nmcli radio wifi on"), lambda: xlinos_cfg.bg("nmcli radio wifi off")),
        ("Bluetooth", xlinos_cfg.bt_on(), lambda: xlinos_cfg.bg("bluetoothctl power on"), lambda: xlinos_cfg.bg("bluetoothctl power off")),
        ("Airplane mode", bool(xlinos_cfg.get("airplane")), lambda: xlinos_cfg.set_airplane(True), lambda: xlinos_cfg.set_airplane(False)),
        ("Do not disturb", bool(xlinos_cfg.get("dnd")), lambda: xlinos_cfg.set_dnd(True), lambda: xlinos_cfg.set_dnd(False)),
        ("Night light", bool(xlinos_cfg.get("night_light")), lambda: xlinos_cfg.set_night_light(True), lambda: xlinos_cfg.set_night_light(False)),
        ("Silent", muted0, lambda: xlinos_cfg.bg("wpctl set-mute @DEFAULT_AUDIO_SINK@ 1"), lambda: xlinos_cfg.bg("wpctl set-mute @DEFAULT_AUDIO_SINK@ 0")),
    ]
    for i, (text, state, on, off) in enumerate(items):
        grid.attach(toggle(text, state, on, off), i % 2, i // 2, 1, 1)
    root.append(grid)
    root.append(slider("Volume", lambda: vol0, xlinos_cfg.set_volume))
    br = xlinos_cfg.brightness()
    if br is not None:
        root.append(slider("Brightness", lambda: br, xlinos_cfg.set_brightness))
    modes = xlinos_cfg.power_modes()
    if modes:
        pm = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6); l = Gtk.Label(label="Power mode", xalign=0); l.add_css_class("sub"); pm.append(l)
        seg = Gtk.Box(spacing=6, homogeneous=True); cur = xlinos_cfg.run("powerprofilesctl get") or "balanced"
        names = {"power-saver": "Saver", "balanced": "Balanced", "performance": "Performance"}
        btns = {}
        for m in modes:
            bt = Gtk.ToggleButton(label=names[m]); bt.add_css_class("act"); bt.set_active(m == cur); btns[m] = bt
            def pick(btn, m=m):
                if not btn.get_active(): return
                for k, o in btns.items():
                    if k != m and o.get_active(): o.set_active(False)
                xlinos_cfg.power_mode(m)
            bt.connect("toggled", pick); seg.append(bt)
        pm.append(seg); root.append(pm)
    more = Gtk.Button(label="All settings"); more.add_css_class("act"); more.connect("clicked", lambda _b: (xlinos_cfg.bg("xlinos-settings"), app.quit())); root.append(more)

    acts = Gtk.Box(spacing=8, homogeneous=True)
    def act(text, cmd, danger=False):
        a = Gtk.Button(label=text); a.add_css_class("act")
        if danger: a.add_css_class("danger")
        a.connect("clicked", lambda _b: (bg(cmd), app.quit())); acts.append(a)
    act("Lock", "xlinos-lock")
    act("Log out", "hyprctl dispatch exit", True)
    act("Restart", "systemctl reboot")
    act("Shut down", "systemctl poweroff")
    root.append(acts)
    w.set_child(root)
    k = Gtk.EventControllerKey()
    k.connect("key-pressed", lambda c, kv, kc, st: (app.quit(), True)[1] if kv == Gdk.KEY_Escape else False)
    w.add_controller(k)
    w.present()

app = Gtk.Application(application_id="os.xlin.quick", flags=Gio.ApplicationFlags.NON_UNIQUE)
app.connect("activate", activate)
sys.exit(app.run(None))
