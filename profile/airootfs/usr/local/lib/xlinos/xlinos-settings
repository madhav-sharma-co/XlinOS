            if i < len(ids): cfg.set_default(m, ids[i])
        dd.connect("notify::selected", pick)
        r = Gtk.Box(spacing=12); r.append(Gtk.Label(label=label, xalign=0, width_chars=16)); r.append(dd); items.append(r)
    b.append(card(*items)); return b

def p_bluetooth():
