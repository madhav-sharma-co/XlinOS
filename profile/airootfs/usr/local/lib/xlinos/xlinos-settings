    scan = Gtk.Button(label="Search for new devices"); scan.add_css_class("primary"); scan.connect("clicked", lambda _b: bg("bluetoothctl --timeout 10 scan on"))
    b.append(card(*(items or [Gtk.Label(label="No devices yet. Press Search, then reopen this page.", xalign=0)])))
    b.append(scan); return b

