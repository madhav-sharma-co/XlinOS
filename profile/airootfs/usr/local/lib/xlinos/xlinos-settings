OV = {"ov": None, "pw": None}
UPD = "/usr/local/lib/xlinos/xlinos-update"

def ask_password(then):
    if OV["pw"]: return then()
    ov = OV["ov"]
    dlg = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10, halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER); dlg.add_css_class("pwbox")
    dlg.append(Gtk.Label(label="Enter your password to update XlinOS", xalign=0))
    e = Gtk.Entry(visibility=False, placeholder_text="Password", width_chars=28); err = Gtk.Label(xalign=0); err.add_css_class("err")
    row_ = Gtk.Box(spacing=8, halign=Gtk.Align.END); cancel = Gtk.Button(label="Cancel"); cancel.add_css_class("sec"); ok = Gtk.Button(label="Continue"); ok.add_css_class("primary")
    row_.append(cancel); row_.append(ok); dlg.append(e); dlg.append(err); dlg.append(row_)
    ov.add_overlay(dlg); e.grab_focus()
    def submit(_w):
        pw = e.get_text()
        good = subprocess.run(["sudo", "-S", "-p", "", "-v"], input=(pw + "\n").encode(), capture_output=True).returncode == 0
        if good: OV["pw"] = pw; ov.remove_overlay(dlg); then()
        else: err.set_text("Wrong password, or this account is not an administrator."); e.set_text("")
    e.connect("activate", submit); ok.connect("clicked", submit); cancel.connect("clicked", lambda _b: ov.remove_overlay(dlg))

def update_card():
    status = Gtk.Label(label="", xalign=0, wrap=True); status.add_css_class("sub")
    check = Gtk.Button(label="Check for updates"); check.add_css_class("sec"); upd = Gtk.Button(label="Update System"); upd.add_css_class("primary")
    bar = Gtk.ProgressBar(show_text=True, visible=False); bar.add_css_class("updbar")
    rb = Gtk.Button(label="Restart now", visible=False); rb.connect("clicked", lambda _b: bg("systemctl reboot"))
    btns = Gtk.Box(spacing=8); btns.append(check); btns.append(upd); btns.append(rb)
    def do_check(_b=None):
        status.set_text("Checking…")
        def work():
            out = run("%s check" % UPD).split()
            def show():
                if len(out) == 2 and out[0] == out[1]: status.set_text("XlinOS is up to date.")
                elif len(out) == 2: status.set_text("An update is available.")
                else: status.set_text("Could not check. Is the computer online?")
                return False
            GLib.idle_add(show)
        threading.Thread(target=work, daemon=True).start()
    def do_update(_b):
        def go():
            check.set_sensitive(False); upd.set_sensitive(False); status.set_text("Starting…")
            bar.set_fraction(0); bar.set_text("0%"); bar.set_visible(True)
            def work():
                p = subprocess.Popen(["sudo", "-S", "-p", "", UPD, "apply"], stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
                p.stdin.write(OV["pw"] + "\n"); p.stdin.flush()
                done = False
                for line in p.stdout:
                    line = line.strip()
                    if line.startswith("STEP "): GLib.idle_add(status.set_text, line[5:] + "…")
                    elif line.startswith("PCT "):
                        try: v = max(0, min(100, int(line[4:])))
                        except ValueError: continue
                        GLib.idle_add(bar.set_fraction, v / 100); GLib.idle_add(bar.set_text, "%d%%" % v)
                    elif line == "DONE": done = True
                p.wait()
                def fin():
                    check.set_sensitive(True); upd.set_sensitive(True)
                    if done and p.returncode == 0: status.set_text("Update finished. Restart to use the new version."); rb.set_visible(True); bar.set_fraction(1); bar.set_text("100%")
                    else: status.set_text("The update did not finish. Check the internet and try again.")
                    return False
                GLib.idle_add(fin)
            threading.Thread(target=work, daemon=True).start()
        ask_password(go)
    check.connect("clicked", do_check); upd.connect("clicked", do_update)
    return card(Gtk.Label(label="System update", xalign=0), status, bar, btns)

def p_about():
    b = page("About XlinOS")
    rel = {}
    try:
        for l in open("/etc/os-release"):
            if "=" in l: k, v = l.strip().split("=", 1); rel[k] = v.strip('"')
    except OSError: pass
    mem = ""
    try: mem = "%.1f GB" % (int(open("/proc/meminfo").readline().split()[1]) / 1048576)
    except Exception: pass
    cpu = ""
    try: cpu = next(l.split(":")[1].strip() for l in open("/proc/cpuinfo") if l.startswith("model name"))
    except Exception: pass
    b.append(card(row("System", rel.get("PRETTY_NAME", "XlinOS")), row("Version", rel.get("VERSION_ID", rel.get("BUILD_ID", ""))),
                  row("Processor", cpu), row("Memory", mem), row("Device name", platform.node())))
    try: cm = open("/usr/share/xlinos/commit").read().strip()[:7]
    except OSError: cm = "development build"
    b.append(card(row("Build", cm)))
    b.append(update_card())
    return b


# ---------------------------------------------------------------- helpers for the new pages
def switch_row(title, sub, active, on_change):
    r = Gtk.Box(spacing=12); t = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, hexpand=True)
    a = Gtk.Label(label=title, xalign=0); t.append(a)
    if sub:
        b = Gtk.Label(label=sub, xalign=0, wrap=True); b.add_css_class("sub"); t.append(b)
    sw = Gtk.Switch(active=bool(active), valign=Gtk.Align.CENTER); sw.connect("state-set", lambda _s, st: on_change(st) or False)
    r.append(t); r.append(sw); return r

def choice_row(title, options, current, on_pick):
    """A row of buttons where one is selected: options = [(label, value)]"""
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6); box.append(Gtk.Label(label=title, xalign=0))
    seg = Gtk.Box(spacing=6); btns = []
    for label, val in options:
        b = Gtk.ToggleButton(label=label); b.set_active(val == current); btns.append((b, val)); seg.append(b)
        def pick(btn, v=val):
            if not btn.get_active(): return
            for o, ov in btns:
                if ov != v and o.get_active(): o.set_active(False)
            on_pick(v)
        b.connect("toggled", pick)
    box.append(seg); return box

def restart_shell():
    subprocess.run(["pkill", "-f", "lib/xlinos/xlinos-shell"], capture_output=True)
    time.sleep(0.5)
    subprocess.Popen(["/usr/local/lib/xlinos/xlinos-shell"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)

