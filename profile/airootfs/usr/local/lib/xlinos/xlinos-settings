    on = "Powered: yes" in run("bluetoothctl show")
    sw = Gtk.Switch(active=on, halign=Gtk.Align.END); sw.connect("state-set", lambda _s, st: bg("rfkill unblock bluetooth; bluetoothctl power " + ("on" if st else "off")) or False)
    r = Gtk.Box(); r.append(Gtk.Label(label="Bluetooth", xalign=0, hexpand=True)); r.append(sw); b.append(card(r))
    devs = []
