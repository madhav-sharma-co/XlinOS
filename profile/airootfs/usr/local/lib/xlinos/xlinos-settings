def p_desktop():
    b = page("Desktop", "What shows in the status bar, which apps are on the run bar, and your wallpaper.")
    items = Gtk.Label(label="Status bar", xalign=0)
    bi = dict(cfg.get("bar_items"))
    def setitem(k, v): bi[k] = v; cfg.set("bar_items", dict(bi)); restart_shell()
    rows = [(k, n) for k, n in (("wifi", "Wi-Fi"), ("bluetooth", "Bluetooth"), ("sound", "Sound"), ("battery", "Battery"), ("clock", "Date and time"))]
    b.append(card(items, *[switch_row("Show " + n, None, bi.get(k, True), lambda v, k=k: setitem(k, v)) for k, n in rows],
                  switch_row("Clock on the desktop", None, cfg.get("show_desktop_clock"), lambda v: (cfg.set("show_desktop_clock", v), restart_shell()))))
    pins = cfg.get("runbar_pins"); allapps = [a[0] for a in xlinos_ui.available()]
    cur = set(allapps if pins is None else pins)
    def setpin(aid, v):
        base = list(allapps if cfg.get("runbar_pins") is None else cfg.get("runbar_pins"))
        base = [x for x in base if x != aid]
        if v: base = [a for a in allapps if a in set(base) | {aid}] + [x for x in base if x not in allapps]
        cfg.set("runbar_pins", base); restart_shell()
    b.append(card(Gtk.Label(label="Apps on the run bar", xalign=0), *[switch_row(a[1], None, a[0] in cur, lambda v, i=a[0]: setpin(i, v)) for a in xlinos_ui.available()]))
    # wallpapers
    import glob, shutil
    pics = sorted(glob.glob("/usr/share/xlinos/wallpapers/*.jpg") + glob.glob("/usr/share/xlinos/wallpapers/*.png") + glob.glob(os.path.expanduser("~/.config/xlinos/wallpapers/*")))
    wp = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, max_children_per_line=3, column_spacing=8, row_spacing=8)
    for f in pics:
        btn = Gtk.Button(); btn.add_css_class("sec")
        try:
            from gi.repository import GdkPixbuf
            pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(f, 160, 100, True); pic = Gtk.Picture.new_for_paintable(Gdk.Texture.new_for_pixbuf(pb)); pic.set_size_request(160, 100)
            btn.set_child(pic)
        except Exception:
            btn.set_label(os.path.basename(f))
        btn.connect("clicked", lambda _b, f=f: (cfg.set("wallpaper", f), restart_shell())); wp.append(btn)
    add = Gtk.Button(label="Add a picture…"); add.add_css_class("primary")
    def chosen(d, res):
        try: f = d.open_finish(res)
        except GLib.Error: return
        dst = os.path.expanduser("~/.config/xlinos/wallpapers"); os.makedirs(dst, exist_ok=True)
        t = os.path.join(dst, os.path.basename(f.get_path())); shutil.copy(f.get_path(), t); cfg.set("wallpaper", t); restart_shell()
    add.connect("clicked", lambda _b: Gtk.FileDialog().open(None, None, chosen))
    b.append(card(Gtk.Label(label="Wallpaper", xalign=0), wp, add))
    return b

def p_apps():
    b = page("Apps and tools", "Choose which app opens each kind of file.")
    apps = cfg.desktop_apps(); names = [a.get_name() for a in apps]; ids = [a.get_id() for a in apps]
    items = []
    for label, mime, _k in cfg.DEFAULT_KINDS:
        cur = cfg.get_default(mime)
        dd = Gtk.DropDown.new_from_strings(names); dd.set_hexpand(True)
        if cur in ids: dd.set_selected(ids.index(cur))
        def pick(d, _p, m=mime):
