        if len(p) == 3:
            conn = "Connected: yes" in run("bluetoothctl info " + p[1]); devs.append((p[1], p[2], conn))
    items = []
    for mac, name, conn in devs:
        rr = Gtk.Box(spacing=12); rr.append(Gtk.Label(label=name, xalign=0, hexpand=True))
        bt = Gtk.Button(label="Disconnect" if conn else "Connect"); bt.add_css_class("sec")
