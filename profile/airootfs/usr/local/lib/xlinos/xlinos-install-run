#!/usr/bin/env bash
# XlinOS installer backend: erases one disk and installs XlinOS on it. Run as root: xlinos-install-run /dev/sdX [options.json]
# Partition mode (keeps other systems): xlinos-install-run /dev/nvmeXnYpN opts.json with {"target":"partition","efi":"/dev/nvmeXnYp1"}
#   formats ONLY that partition, shares the existing EFI partition, installs GRUB as "XlinOS" and leaves other systems untouched.
# options.json (all optional): {"locale":"en_US.UTF-8","kb":"us","tz":"Europe/Berlin","fs":"ext4|btrfs","hostname":"xlin"}
# Prints plain progress lines:  STEP <n>/<total> <text>  then  DONE  or  FAIL <reason>. The full log is /var/log/xlinos-install.log.
LOG=/var/log/xlinos-install.log
exec 3>&1 1>>"$LOG" 2>&1
say() { echo "$*" >&3; }
fail() { say "FAIL $*"; exit 1; }
set -x
set -o pipefail
DISK="${1:-}"; OPTS="${2:-}"; T=5
opt() { python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get(sys.argv[2],sys.argv[3]))' "${OPTS:-/dev/null}" "$1" "$2" 2>/dev/null || echo "$2"; }
[[ -f "$OPTS" ]] || OPTS=""
FS="$(opt fs ext4)"; [[ "$FS" == btrfs ]] || FS=ext4
[[ $EUID -eq 0 ]] || fail "The installer must run as the administrator."
[[ -b "$DISK" ]] || fail "That disk was not found."
[[ -d /sys/firmware/efi ]] || fail "This computer did not start in UEFI mode. Turn UEFI on in the firmware settings and start the installer again."
cfg=/usr/share/xlinos/archinstall-config.json
[[ -f "$cfg" ]] || fail "The installer files are missing."
TARGET="$(opt target disk)"
say "STEP 1/$T Checking the internet connection"
curl -sI --max-time 8 -o /dev/null https://github.com || curl -sI --max-time 8 -o /dev/null https://archlinux.org || fail "No internet connection. Connect to Wi-Fi or a cable and try again (the system is downloaded while installing)."
if [[ "$TARGET" == partition ]]; then
  EFI="$(opt efi "")"
  [[ -b "$EFI" ]] || fail "The shared start-up (EFI) partition was not found."
  [[ "$(lsblk -no PARTTYPE "$DISK" 2>/dev/null)" != c12a7328-f81f-11d2-ba4b-00a0c93ec93b ]] || fail "That is the start-up partition. Choose a normal partition."
  findmnt -rn -S "$DISK" >/dev/null && fail "That partition is in use. Choose a free partition."
  say "STEP 2/$T Preparing the partition (other systems stay untouched)"
  umount -R /mnt 2>/dev/null
  if [[ "$FS" == btrfs ]]; then mkfs.btrfs -qf "$DISK" && mount -o compress=zstd "$DISK" /mnt; else mkfs.ext4 -qF "$DISK" && mount "$DISK" /mnt; fi || fail "Could not format the partition."
  mkdir -p /mnt/efi && mount "$EFI" /mnt/efi || fail "Could not use the shared start-up partition."
  say "STEP 3/$T Installing the system (this takes a few minutes)"
  XOPTS="$OPTS" python3 - <<'PY' || fail "Installer settings are broken."
import json, os
c = json.load(open("/usr/share/xlinos/archinstall-config.json"))
o = json.load(open(os.environ["XOPTS"])) if os.environ.get("XOPTS") else {}
pk = list(c.get("packages", [])) + ["base", "linux", "linux-firmware", "grub", "efibootmgr", "networkmanager", "btrfs-progs"]
open("/tmp/xl-pkgs", "w").write(" ".join(dict.fromkeys(pk)))
post = c["custom_commands"][0]
open("/tmp/xl-post.sh", "w").write(post + "\n")
open("/tmp/xl-host", "w").write(o.get("hostname") or c.get("hostname", "xlin"))
open("/tmp/xl-tz", "w").write(o.get("tz") or "UTC")
open("/tmp/xl-lang", "w").write(o.get("locale") or "en_US.UTF-8")
open("/tmp/xl-kb", "w").write(o.get("kb") or "us")
PY
  pacstrap -K /mnt $(cat /tmp/xl-pkgs) || fail "Downloading the system failed. Check the internet. The log is in /var/log/xlinos-install.log."
  genfstab -U /mnt >/mnt/etc/fstab || fail "Could not write the installed system's filesystem table."
  echo "$(cat /tmp/xl-host)" >/mnt/etc/hostname
  ln -sf "/usr/share/zoneinfo/$(cat /tmp/xl-tz)" /mnt/etc/localtime
  L="$(cat /tmp/xl-lang)"; sed -i "s/^#\($L \)/\1/" /mnt/etc/locale.gen; echo "LANG=$L" >/mnt/etc/locale.conf; echo "KEYMAP=$(cat /tmp/xl-kb)" >/mnt/etc/vconsole.conf
  arch-chroot /mnt locale-gen || fail "Could not generate the selected locale."
  arch-chroot /mnt systemctl enable NetworkManager systemd-timesyncd || fail "Could not enable the network and time services."
  say "STEP 4/$T Setting up the start menu"
  arch-chroot /mnt grub-install --target=x86_64-efi --efi-directory=/efi --bootloader-id=XlinOS || fail "Could not set up the start menu."
  sed -i 's/^GRUB_CMDLINE_LINUX_DEFAULT=.*/GRUB_CMDLINE_LINUX_DEFAULT="quiet loglevel=3"/; s/^#\?GRUB_DISABLE_OS_PROBER=.*/GRUB_DISABLE_OS_PROBER=false/' /mnt/etc/default/grub
  grep -q '^GRUB_DISTRIBUTOR' /mnt/etc/default/grub && sed -i 's/^GRUB_DISTRIBUTOR=.*/GRUB_DISTRIBUTOR="XlinOS"/' /mnt/etc/default/grub
  pacstrap /mnt os-prober >/dev/null 2>&1 || fail "Could not install os-prober, which is needed to detect the other operating systems."
  arch-chroot /mnt grub-mkconfig -o /boot/grub/grub.cfg || fail "Could not set up the start menu."
  cp /tmp/xl-post.sh /mnt/tmp/xl-post.sh || fail "Could not prepare XlinOS setup."
  arch-chroot /mnt bash /tmp/xl-post.sh 2>&1 | tee /mnt/var/log/xlinos-post.log || fail "XlinOS desktop setup failed. The log is in /var/log/xlinos-install.log and /var/log/xlinos-post.log."
  say "STEP 5/$T Done"
  sync; umount -R /mnt 2>/dev/null
  say "DONE"; exit 0
fi
say "STEP 2/$T Preparing the disk"
p=""; [[ "$DISK" =~ [0-9]$ ]] && p="p"
umount -R /mnt 2>/dev/null; swapoff -a 2>/dev/null
if lsblk -nrpo MOUNTPOINT "$DISK" 2>/dev/null | grep -q '^/run/archiso' && ! grep -qw copytoram=y /proc/cmdline && [[ ! -f /run/archiso/copytoram ]]; then
  fail "XlinOS was started from a file on this disk. Restart it with copytoram=y so it can run from memory, or pick another disk."
fi
# started from an ISO file stored on this same disk (loopback boot)? let go of it first (the system runs from RAM when started with copytoram=y)
for m in $(lsblk -nrpo MOUNTPOINT "$DISK" 2>/dev/null | grep -v '^$' | sort -r); do umount -R "$m" 2>/dev/null; done
losetup -D 2>/dev/null
# forget the old partitions first, so the kernel does not hold on to the old layout
for old in $(lsblk -nrpo PATH "$DISK" | tail -n +2); do wipefs -a "$old" >/dev/null 2>&1; done
partx -d "$DISK" >/dev/null 2>&1
sgdisk -Z "$DISK" && sgdisk -n1:0:+512M -t1:ef00 -n2:0:0 -t2:8300 "$DISK" || fail "Could not partition the disk."
partprobe "$DISK" >/dev/null 2>&1; udevadm settle
for i in $(seq 1 20); do [[ -b "${DISK}${p}1" && -b "${DISK}${p}2" ]] && break; partprobe "$DISK" >/dev/null 2>&1; partx -a "$DISK" >/dev/null 2>&1; sleep 1; done
[[ -b "${DISK}${p}1" && -b "${DISK}${p}2" ]] || fail "The new partitions did not appear. Restart the computer and try again."
mkfs_retry() { for i in 1 2 3 4; do "$@" && return 0; sleep 2; udevadm settle; done; return 1; }
mkfs_retry mkfs.fat -F32 "${DISK}${p}1" || fail "Could not format the disk."
if [[ "$FS" == btrfs ]]; then mkfs_retry mkfs.btrfs -qf "${DISK}${p}2" && mount -o compress=zstd "${DISK}${p}2" /mnt; else mkfs_retry mkfs.ext4 -qF "${DISK}${p}2" && mount "${DISK}${p}2" /mnt; fi || fail "Could not format the disk."
mkdir -p /mnt/boot && mount "${DISK}${p}1" /mnt/boot || fail "Could not use the disk."
XOPTS="$OPTS" XFS="$FS" python3 - <<'PY' || fail "Installer settings are broken."
import json, os
c = json.load(open("/usr/share/xlinos/archinstall-config.json"))
c["bootloader"] = "systemd-boot"
c["disk_config"] = {"config_type": "pre_mounted_config", "mountpoint": "/mnt"}
o = {}
if os.environ.get("XOPTS"):
    try: o = json.load(open(os.environ["XOPTS"]))
    except Exception: pass
lc = c.setdefault("locale_config", {})
if o.get("locale"): lc["sys_lang"] = o["locale"]
if o.get("kb"): lc["kb_layout"] = o["kb"]
if o.get("tz"): c["timezone"] = o["tz"]
if o.get("hostname"): c["hostname"] = o["hostname"]
if os.environ.get("XFS") == "btrfs": c["packages"] = list(c.get("packages", [])) + ["btrfs-progs"]
json.dump(c, open("/tmp/xlinos-install.json", "w"), indent=1)
PY
say "STEP 3/$T Installing the system (this takes a few minutes)"
archinstall --config /tmp/xlinos-install.json --silent || fail "The installation failed. The log is in /var/log/xlinos-install.log."
say "STEP 4/$T Finishing"
sync; umount -R /mnt 2>/dev/null
say "STEP 5/$T Done"
say "DONE"
