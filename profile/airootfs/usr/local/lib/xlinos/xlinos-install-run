#!/usr/bin/env bash
# XlinOS installer backend: erases one disk and installs XlinOS on it. Run as root: xlinos-install-run /dev/sdX [options.json]
# options.json (all optional): {"locale":"en_US.UTF-8","kb":"us","tz":"Europe/Berlin","fs":"ext4|btrfs","hostname":"xlin"}
# Prints plain progress lines:  STEP <n>/<total> <text>  then  DONE  or  FAIL <reason>. The full log is /var/log/xlinos-install.log.
LOG=/var/log/xlinos-install.log
exec 3>&1 1>>"$LOG" 2>&1
say() { echo "$*" >&3; }
fail() { say "FAIL $*"; exit 1; }
set -x
DISK="${1:-}"; OPTS="${2:-}"; T=5
opt() { python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get(sys.argv[2],sys.argv[3]))' "${OPTS:-/dev/null}" "$1" "$2" 2>/dev/null || echo "$2"; }
[[ -f "$OPTS" ]] || OPTS=""
FS="$(opt fs ext4)"; [[ "$FS" == btrfs ]] || FS=ext4
[[ $EUID -eq 0 ]] || fail "The installer must run as the administrator."
[[ -b "$DISK" ]] || fail "That disk was not found."
[[ -d /sys/firmware/efi ]] || fail "This computer did not start in UEFI mode. Turn UEFI on in the firmware settings and start the installer again."
cfg=/usr/share/xlinos/archinstall-config.json
[[ -f "$cfg" ]] || fail "The installer files are missing."
say "STEP 1/$T Checking the internet connection"
curl -sI --max-time 8 -o /dev/null https://github.com || curl -sI --max-time 8 -o /dev/null https://archlinux.org || fail "No internet connection. Connect to Wi-Fi or a cable and try again (the system is downloaded while installing)."
say "STEP 2/$T Preparing the disk"
p=""; [[ "$DISK" =~ [0-9]$ ]] && p="p"
umount -R /mnt 2>/dev/null; swapoff -a 2>/dev/null
sgdisk -Z "$DISK" && sgdisk -n1:0:+512M -t1:ef00 -n2:0:0 -t2:8300 "$DISK" || fail "Could not partition the disk."
partprobe "$DISK"; sleep 2; udevadm settle
mkfs.fat -F32 "${DISK}${p}1" || fail "Could not format the disk."
if [[ "$FS" == btrfs ]]; then mkfs.btrfs -qf "${DISK}${p}2" && mount -o compress=zstd "${DISK}${p}2" /mnt; else mkfs.ext4 -qF "${DISK}${p}2" && mount "${DISK}${p}2" /mnt; fi || fail "Could not format the disk."
mkdir -p /mnt/boot && mount "${DISK}${p}1" /mnt/boot || fail "Could not use the disk."
XOPTS="$OPTS" XFS="$FS" python3 - <<'PY' || fail "Installer settings are broken."
import json, os
c = json.load(open("/usr/share/xlinos/archinstall-config.json"))
c["bootloader"] = "systemd-boot"
c["disk_config"] = {"config_type": "pre_mounted_config", "mountpoint": "/mnt"}
o = {}
if os.environ.get("XOPTS"):
    try: o = json.load(open(os.environ["XOPTS"]))
    except Exception: pass
lc = c.setdefault("locale_config", {})
if o.get("locale"): lc["sys_lang"] = o["locale"]
if o.get("kb"): lc["kb_layout"] = o["kb"]
if o.get("tz"): c["timezone"] = o["tz"]
if o.get("hostname"): c["hostname"] = o["hostname"]
if os.environ.get("XFS") == "btrfs": c["packages"] = list(c.get("packages", [])) + ["btrfs-progs"]
json.dump(c, open("/tmp/xlinos-install.json", "w"), indent=1)
PY
say "STEP 3/$T Installing the system (this takes a few minutes)"
archinstall --config /tmp/xlinos-install.json --silent || fail "The installation failed. The log is in /var/log/xlinos-install.log."
say "STEP 4/$T Finishing"
sync; umount -R /mnt 2>/dev/null
say "STEP 5/$T Done"
say "DONE"
