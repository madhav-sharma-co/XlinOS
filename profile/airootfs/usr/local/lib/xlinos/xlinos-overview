#!/usr/bin/env python3
"""XlinOS window overview (Super+Tab): every open window as a card; click one to bring it forward."""
import json, os, subprocess, sys
LIB = "/usr/lib/libgtk4-layer-shell.so"
if os.path.exists(LIB) and LIB not in os.environ.get("LD_PRELOAD", ""):
    os.environ["LD_PRELOAD"] = (os.environ.get("LD_PRELOAD", "") + " " + LIB).strip()
    os.execv(sys.executable, [sys.executable] + sys.argv)
# the preload is only for this program: apps it starts (Firefox, ...) must not inherit it
if LIB in os.environ.get("LD_PRELOAD", ""):
    _rest = os.environ["LD_PRELOAD"].replace(LIB, "").split()
    if _rest: os.environ["LD_PRELOAD"] = " ".join(_rest)
    else: os.environ.pop("LD_PRELOAD", None)
import gi
gi.require_version("Gtk", "4.0"); gi.require_version("Gtk4LayerShell", "1.0")
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from gi.repository import Gtk, Gdk, Gio, GLib, Gtk4LayerShell as LS
import xlinos_ui

CSS = (b"""/*nolight*/
window { background: rgba(3,8,28,0.90); }
.title { color: #fff; font-size: 22px; font-weight: 700; }
.hint { color: #9db4e6; font-size: 14px; }
.card { background: rgba(255,255,255,0.07); border: 1px solid rgba(255,255,255,0.12); border-radius: 18px; padding: 18px 16px; min-width: 210px; color: #fff; box-shadow: none; }
.card:hover, .card:focus { background: rgba(79,147,255,0.22); border-color: #4f93ff; }
.card .name { font-weight: 700; font-size: 14px; }
.card .win { color: #9db4e6; font-size: 12px; }
.mini { color: #9db4e6; font-size: 11px; }
""" + xlinos_ui.css().encode())

def hc(*a):
    return subprocess.run(["hyprctl", *a], capture_output=True, text=True, timeout=4).stdout
def lua(code):
    subprocess.run(["hyprctl", "eval", code], capture_output=True, text=True, timeout=4)

def windows():
    out = []
    for c in json.loads(hc("-j", "clients") or "[]"):
        if not c.get("mapped", True) or (c.get("class") or "").startswith("xlinos-"): continue
        out.append(c)
    return out

def bring(c):
    ws = json.loads(hc("-j", "activeworkspace") or "{}").get("id", 1)
    if c["workspace"]["name"].startswith("special:"):
        lua('hl.dispatch(hl.dsp.window.move({ workspace = %d, follow = true, window = "address:%s" }))' % (ws, c["address"]))
    lua('hl.dispatch(hl.dsp.focus({ window = "address:%s" }))' % c["address"])
    lua('hl.dispatch(hl.dsp.window.alter_zorder({ mode = "top", window = "address:%s" }))' % c["address"])

def activate(app):
    p = Gtk.CssProvider(); p.load_from_data(CSS)
    Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), p, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    w = Gtk.ApplicationWindow(application=app)
    LS.init_for_window(w); LS.set_layer(w, LS.Layer.OVERLAY); LS.set_namespace(w, "xlinos-overview")
    for e in (LS.Edge.TOP, LS.Edge.BOTTOM, LS.Edge.LEFT, LS.Edge.RIGHT): LS.set_anchor(w, e, True)
    LS.set_exclusive_zone(w, -1); LS.set_keyboard_mode(w, LS.KeyboardMode.EXCLUSIVE)
    root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=26, margin_top=90, margin_bottom=60, margin_start=80, margin_end=80)
    title = Gtk.Label(label="Open windows"); title.add_css_class("title"); root.append(title)
    by_cls = {a[5].lower(): a for a in xlinos_ui.APPS if a[5]}
    flow = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, max_children_per_line=6, min_children_per_line=2, homogeneous=True,
                       halign=Gtk.Align.CENTER, valign=Gtk.Align.START, row_spacing=14, column_spacing=14)
    ws = windows()
    for c in ws:
        a = by_cls.get((c.get("class") or "").lower())
        key = a[0] if a else None
        b = Gtk.Button(); b.add_css_class("card")
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10, halign=Gtk.Align.CENTER)
        tile = Gtk.Box(halign=Gtk.Align.CENTER); tile.add_css_class("apptile"); tile.add_css_class("t-" + key if key else "t-apps"); tile.set_size_request(64, 64)
        im = Gtk.Image.new_from_icon_name(a[2] if a else "application-x-executable-symbolic"); im.set_pixel_size(30)
        im.set_hexpand(True); im.set_vexpand(True); im.set_halign(Gtk.Align.CENTER); im.set_valign(Gtk.Align.CENTER); tile.append(im)
        nm = Gtk.Label(label=xlinos_ui.friendly(c.get("class") or "")); nm.add_css_class("name")
        tt = Gtk.Label(label=c.get("title") or "", ellipsize=3, max_width_chars=24); tt.add_css_class("win")
        for x in (tile, nm, tt): box.append(x)
        if c["workspace"]["name"].startswith("special:"):
            m = Gtk.Label(label="minimised"); m.add_css_class("mini"); box.append(m)
        b.set_child(box); b.connect("clicked", lambda _b, c=c: (bring(c), app.quit())); flow.append(b)
    if ws: root.append(flow)
    else:
        h = Gtk.Label(label="No windows are open."); h.add_css_class("hint"); root.append(h)
    hint = Gtk.Label(label="Click a window to bring it forward  -  Esc to close"); hint.add_css_class("hint"); root.append(hint)
    w.set_child(root)
    k = Gtk.EventControllerKey(); k.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)
    k.connect("key-pressed", lambda c, kv, kc, st: (app.quit(), True)[1] if kv in (Gdk.KEY_Escape,) else False)
    w.add_controller(k); w.present()

app = Gtk.Application(application_id="os.xlin.overview", flags=Gio.ApplicationFlags.NON_UNIQUE)
app.connect("activate", activate); sys.exit(app.run(None))
