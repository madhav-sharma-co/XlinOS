#!/usr/bin/env python3
"""XlinOS Notes: plain notes saved in ~/Documents/Notes."""
import os, sys, time
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import gi
gi.require_version("Gtk", "4.0")
from gi.repository import Gtk, Gdk, Gio, GLib
import xlinos_ui

DIR = os.path.expanduser("~/Documents/Notes")
CSS = (xlinos_ui.window_css() + """
window { background: transparent; }
.side { background: rgba(255,255,255,0.04); padding: 10px 8px; min-width: 210px; border-radius: 0 0 0 14px; }
.side button.n { background: transparent; border: none; box-shadow: none; color: #cdd9f5; border-radius: 9px; padding: 8px 10px; }
.side button.n:hover { background: rgba(255,255,255,0.08); }
.side button.sel { background: #1e4fd0; color: #fff; }
button.new { background: #1e6bff; color: #fff; border: none; border-radius: 10px; padding: 8px; margin-bottom: 8px; }
textview, textview text { background: transparent; color: #eaf0ff; font-size: 15px; }
.note { padding: 14px 18px; }
""").encode()

def activate(app):
    p = Gtk.CssProvider(); p.load_from_data(CSS)
    Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), p, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    os.makedirs(DIR, exist_ok=True)
    win, body = xlinos_ui.make_window(app, "Notes", 820, 540)
    main = Gtk.Box(vexpand=True)
    side = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2); side.add_css_class("side")
    newb = Gtk.Button(label="New note"); newb.add_css_class("new"); side.append(newb)
    lst = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2); sl = Gtk.ScrolledWindow(vexpand=True); sl.set_child(lst); side.append(sl)
    tv = Gtk.TextView(wrap_mode=Gtk.WrapMode.WORD_CHAR, hexpand=True, vexpand=True); tv.add_css_class("note")
    sc = Gtk.ScrolledWindow(hexpand=True, vexpand=True); sc.set_child(tv)
    main.append(side); main.append(sc); body.append(main)
    st = {"cur": None, "timer": 0, "loading": False}
    buf = tv.get_buffer()

    def save():
        st["timer"] = 0
        if st["cur"]:
            a, b = buf.get_bounds(); open(st["cur"], "w").write(buf.get_text(a, b, False))
            refresh(False)
        return False
    def title(path):
        try: first = open(path).readline().strip()
        except OSError: first = ""
        return first[:28] or "New note"
    def refresh(select=True):
        c = lst.get_first_child()
        while c: n = c.get_next_sibling(); lst.remove(c); c = n
        files = sorted((f for f in os.listdir(DIR) if f.endswith(".txt")), key=lambda f: -os.path.getmtime(os.path.join(DIR, f)))
        for f in files:
            pth = os.path.join(DIR, f); b = Gtk.Button(label=title(pth), halign=Gtk.Align.FILL); b.add_css_class("n")
            b.get_child().set_xalign(0)
            if pth == st["cur"]: b.add_css_class("sel")
            b.connect("clicked", lambda _b, p_=pth: opennote(p_)); lst.append(b)
    def opennote(path):
        if st["timer"]: GLib.source_remove(st["timer"]); save()
        st["cur"] = path; st["loading"] = True
        buf.set_text(open(path).read() if os.path.exists(path) else ""); st["loading"] = False
        refresh(); tv.grab_focus()
    def new(_b=None):
        path = os.path.join(DIR, time.strftime("%Y%m%d-%H%M%S") + ".txt"); open(path, "w").close(); opennote(path)
    def changed(_b):
        if st["loading"]: return
        if st["timer"]: GLib.source_remove(st["timer"])
        st["timer"] = GLib.timeout_add(600, save)
    buf.connect("changed", changed); newb.connect("clicked", new)
    win.connect("close-request", lambda w: (save() if st["cur"] else None, False)[1])
    files = [f for f in os.listdir(DIR) if f.endswith(".txt")]
    refresh()
    if files: opennote(os.path.join(DIR, sorted(files, key=lambda f: -os.path.getmtime(os.path.join(DIR, f)))[0]))
    else: new()
    win.present()

app = Gtk.Application(application_id="os.xlin.notes", flags=Gio.ApplicationFlags.NON_UNIQUE)
app.connect("activate", activate); sys.exit(app.run(None))
