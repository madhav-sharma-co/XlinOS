#!/usr/bin/env bash
# XlinOS window snapping via xlin-comp (left|right|top|bottom|tl|tr|bl|br|max|restore|center).
set -u
act="${1:-}"
case "$act" in
  left|right|top|bottom|tl|tr|bl|br|max|restore|center)
    exec xlinctl snap "$act" ;;
  *)
    echo "usage: xlinos-snap left|right|top|bottom|tl|tr|bl|br|max|restore|center" >&2
    exit 1 ;;
esac
