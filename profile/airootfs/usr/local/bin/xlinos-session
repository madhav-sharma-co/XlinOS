#!/usr/bin/env bash
# Starts the Xlin-soft desktop for the logged-in user. The first time, Xlin-soft is set up for this user.
if [[ ! -f "$HOME/.config/xlin/state/source" && -d /opt/xlin-soft ]]; then
  src="$HOME/.Xlin-soft"
  [[ -d "$src" ]] || cp -r /opt/xlin-soft "$src"
  if command -v xlin >/dev/null 2>&1 && [[ ! -w /usr/local/bin ]]; then
    # installed system: the programs, packages and services were set up for everyone at install time,
    # so a user without admin rights must not (and cannot) use sudo here. A stand-in "sudo" that only
    # skips those steps is used for this one run. It never gains any rights.
    shim="$(mktemp -d)"; printf '#!/bin/sh\nexit 0\n' >"$shim/sudo"; chmod +x "$shim/sudo"; export PATH="$shim:$PATH"
  fi
  ( cd "$src" && XLIN_NO_UPGRADE=1 bash install.sh </dev/null ) >"$HOME/.xlinos-first-start.log" 2>&1 \
    || echo "XlinOS: desktop setup had a problem, see ~/.xlinos-first-start.log"
  mkdir -p "$HOME/.config/xlin/state"; echo "$src" >"$HOME/.config/xlin/state/source"
fi
export XDG_CURRENT_DESKTOP=Hyprland XDG_SESSION_TYPE=wayland XDG_SESSION_DESKTOP=Hyprland
# virtual machines and old graphics: let Hyprland draw in software when there is no GPU driver for it
if command -v systemd-detect-virt >/dev/null && systemd-detect-virt -q; then
  export WLR_RENDERER_ALLOW_SOFTWARE=1 WLR_NO_HARDWARE_CURSORS=1
fi
exec Hyprland
