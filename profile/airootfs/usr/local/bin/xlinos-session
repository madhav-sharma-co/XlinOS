#!/usr/bin/env bash
# Starts the XlinOS compositor and desktop for the logged-in user.
export XDG_CURRENT_DESKTOP=XlinOS XDG_SESSION_TYPE=wayland XDG_SESSION_DESKTOP=XlinOS

# Virtual machines and old graphics: draw in software when there is no GPU driver
if command -v systemd-detect-virt >/dev/null && systemd-detect-virt -q; then
  export WLR_RENDERER=pixman WLR_NO_HARDWARE_CURSORS=1 GSK_RENDERER=cairo   # plain software drawing: reliable on virtual screens
fi

# Text size chosen in Settings
SCALE="$(python3 -c "import json,os;print(json.load(open(os.path.expanduser('~/.config/xlinos/settings.json'))).get('text_scale',1.0))" 2>/dev/null)"
[ -n "$SCALE" ] && export GDK_DPI_SCALE="$SCALE"

LOG="${XDG_RUNTIME_DIR:-/tmp}/xlinos-compositor.log"
if [ -d /run/archiso ]; then
  exec xlin-comp -c /usr/share/xlinos/installer.conf >"$LOG" 2>&1
else
  mkdir -p "$HOME/.cache" 2>/dev/null && LOG="$HOME/.cache/xlinos-compositor.log"   # kept on disk so problems can be read later
  exec xlin-comp -c /usr/share/xlinos/xlin.conf >"$LOG" 2>&1
fi
