#!/usr/bin/env bash
# Starts the XlinOS desktop for the logged-in user.
export XDG_CURRENT_DESKTOP=Hyprland XDG_SESSION_TYPE=wayland XDG_SESSION_DESKTOP=Hyprland   # names the system parts expect; never shown
# XlinOS owns its window settings: they are placed fresh at every login
mkdir -p "$HOME/.config/hypr"
cp /usr/share/xlinos/hypr/hyprland.lua "$HOME/.config/hypr/hyprland.lua"
# virtual machines and old graphics: draw in software when there is no GPU driver
if command -v systemd-detect-virt >/dev/null && systemd-detect-virt -q; then
  export WLR_RENDERER_ALLOW_SOFTWARE=1 WLR_NO_HARDWARE_CURSORS=1
fi
command -v start-hyprland >/dev/null 2>&1 && exec start-hyprland
exec Hyprland
